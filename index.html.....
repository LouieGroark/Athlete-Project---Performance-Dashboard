// ==================== FIXTURE WEBSITE SCAN ====================
// Best-effort: reads a club's fixtures page(s) via a read-only text proxy (so the
// browser doesn't get blocked by the site's own CORS rules), then looks for
// "<date> ... TeamA v TeamB" patterns across every page given, so a full season
// can be pulled even when a club splits fixtures/results across pages. Also
// tries to keep first-team matches only, using team-section headings on the
// page plus an optional keyword, and skips anything that looks like a 2nd XV,
// colts, ladies, etc. fixture. Site layouts vary a lot, so this won't always
// get everything — the pasted-text fallback covers the rest.
const FX_OTHER_TEAM_RE = /\b(2nd|3rd|4th|5th|6th|second|third|fourth|fifth|sixth)\s*(team|xv|x\s*v)?s?\b|\bcolts?\b|\bacademy\b|\byouths?\b|\bminis?\b|\bjuniors?\b|\bvets?\b|\bveterans?\b|\bladies\b|\bwomen'?s?\b|\bgirls\b|\bu1[0-9]\b|\bu2[0-9]\b/i;
const FX_FIRST_TEAM_RE = /\b(1st|first)\s*(team|xv|x\s*v)?\b|\bfirsts\b|\bseniors?\b/i;
function parseFixturesFromText(text, myTeam, teamLabel){
  if(!text) return [];
  const months = {Jan:0,Feb:1,Mar:2,Apr:3,May:4,Jun:5,Jul:6,Aug:7,Sep:8,Oct:9,Nov:10,Dec:11};
  const dayNames = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
  const dateRe = /(\d{1,2})\s+(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*\s+(\d{4})/i;
  const vRe = /([A-Za-z][A-Za-z .'\-]{2,40}?)\s+v[s]?\.?\s+([A-Za-z][A-Za-z .'\-]{2,40})/i;
  const teamKey = (myTeam||'').trim().toLowerCase();
  const labelKey = (teamLabel||'').trim().toLowerCase();
  const lines = text.split('\n');
  const found = [];
  let section = null; // 'first' | 'other' | null (unlabelled so far)
  for(let i=0;i<lines.length;i++){
    const line = lines[i];
    // short lines that look like a team-section heading update which team block we're in
    if(line.trim().length && line.trim().length < 60 && !dateRe.test(line)){
      if(FX_FIRST_TEAM_RE.test(line) && !FX_OTHER_TEAM_RE.test(line)){ section = 'first'; continue; }
      if(FX_OTHER_TEAM_RE.test(line)){ section = 'other'; continue; }
    }
    const dm = line.match(dateRe);
    if(!dm) continue;
    const context = [lines[i-1]||'', line, lines[i+1]||'', lines[i+2]||''].join(' ');
    const vm = context.match(vRe);
    if(!vm) continue;
    // first-team filtering: prefer an explicit keyword match; otherwise fall back to the
    // section we're currently reading, then to excluding any obvious other-team mention nearby.
    if(labelKey){
      if(!context.toLowerCase().includes(labelKey) && section!=='first') continue;
    } else if(section==='other'){
      continue;
    } else if(section===null && FX_OTHER_TEAM_RE.test(context)){
      continue;
    }
    let home = vm[1].replace(/^[-–•\d:.\s]+/, '').trim();
    let away = vm[2].replace(/[-–•].*$/, '').trim();
    if(!home || !away) continue;
    const d = new Date(Number(dm[3]), months[dm[2].slice(0,3)], Number(dm[1]));
    const dateStr = `${dayNames[d.getDay()]} ${String(dm[1]).padStart(2,'0')} ${dm[2].slice(0,3)} ${dm[3]}`;
    let venue, opp;
    if(teamKey && home.toLowerCase().includes(teamKey)){ venue='H'; opp=away; }
    else if(teamKey && away.toLowerCase().includes(teamKey)){ venue='A'; opp=home; }
    else { venue='H'; opp=away; } // couldn't match "your team" — best guess, user can fix venue manually
    found.push({ date: dateStr, ko: '-', venue, opp, comp: (LIVE && LIVE.competition) || '', result: null, _d: d.getTime() });
  }
  const seen = new Set();
  const uniq = found.filter(f=>{ const k=f.date+'|'+f.opp; if(seen.has(k)) return false; seen.add(k); return true; });
  uniq.sort((a,b)=>a._d-b._d);
  uniq.forEach((f,i)=>{ f.wk = i+1; delete f._d; });
  return uniq;
}
function applyScannedFixtures(found){
  // carry over any results already recorded against the same date+opponent
  found.forEach(f=>{
    const prev = DATA.fixtures.find(x=>x.date===f.date && x.opp===f.opp);
    if(prev && prev.result) f.result = prev.result;
  });
  DATA.fixtures = found;
  applyLiveFeed();
  renderFixtures();
  renderOverview();
}
async function scanClubWebsite(urls){
  const statusEl = document.getElementById('fx-scan-status');
  const manualEl = document.getElementById('fx-scan-manual');
  const myTeam = document.getElementById('fx-my-team').value.trim();
  const teamLabel = document.getElementById('fx-team-label').value.trim();
  statusEl.textContent = `Fetching ${urls.length} page${urls.length>1?'s':''}…`;
  manualEl.style.display = 'none';
  let combined = '';
  let failures = 0;
  for(const url of urls){
    try{
      const res = await fetch('https://r.jina.ai/' + url);
      if(!res.ok) throw new Error('fetch failed');
      combined += '\n' + await res.text();
    }catch(e){ failures++; }
  }
  const found = parseFixturesFromText(combined, myTeam, teamLabel);
  if(!found.length){
    statusEl.textContent = failures===urls.length
      ? "Couldn't fetch any of those pages automatically (the site may block it). Paste the fixtures text below instead."
      : "Fetched the page(s) but couldn't find any first-team fixtures. Try adding a first-team keyword above, or paste the fixtures text below instead.";
    manualEl.style.display = '';
    return;
  }
  applyScannedFixtures(found);
  let msg = `Found ${found.length} fixture${found.length>1?'s':''} — list updated below. Double-check dates, home/away and that these are all first-team before relying on it.`;
  if(failures) msg += ` (${failures} of ${urls.length} page${urls.length>1?'s':''} couldn't be fetched.)`;
  statusEl.textContent = msg;
}
