// ==================== SESSION LOG (overview) ====================
// Every session ticked off on Weekly Sessions appears here, newest first. Click a row to open that week.
const SESSION_DAYS = [['mon','MON','Lower 1',0],['tue','TUE','Upper 1',1],['wed','WED','Lower 2',2],['thu','THU','Upper 2',3]];
let sessionLogShowAll = false;
function renderSessionLog(){
  const el = document.getElementById('ov-sesslog');
  if(!el) return;
  const items = [];
  Object.keys(completed).filter(k=>completed[k]).forEach(k=>{
    const [wn, dk] = k.split('-');
    const w = DATA.weeks.find(x=>x.wk===+wn), meta = SESSION_DAYS.find(d=>d[0]===dk);
    if(!w || !meta) return;
    const base = parseDate(w.date);
    const date = new Date(base.getFullYear(), base.getMonth(), base.getDate() + meta[3]);
    const text = w[dk] || '';
    const special = text.match(/^(Bye Week Development Session|Fixture-Congestion \/ Christmas Maintenance Session)/);
    const liftM = special ? null : text.match(/^(?:Strength[^:\n]*|Main Lift):\s*([^—\n]+?)\s*(?:—|$)/m);
    items.push({k, w, meta, date, title: special ? special[1] : meta[2], lift: liftM ? liftM[1].trim() : '', at: completedAt[k] ? new Date(completedAt[k]) : null});
  });
  items.sort((a,b)=> b.date - a.date);
  document.getElementById('ov-sesslog-count').textContent = `${items.length} session${items.length===1?'':'s'} logged`;
  if(!items.length){
    el.innerHTML = '<div style="color:var(--muted2);font-size:13px;">No sessions logged yet — tick a day\'s circle on Weekly Sessions and it will appear here.</div>';
    return;
  }
  const LIMIT = 8, shown = sessionLogShowAll ? items : items.slice(0, LIMIT);
  const dayCls = {mon:'day-mon', tue:'day-tue', wed:'day-wed', thu:'day-thu'};
  el.innerHTML = shown.map(it=>{
    const dStr = it.date.toLocaleDateString('en-GB', {weekday:'short', day:'numeric', month:'short', year:'numeric'});
    const logged = it.at ? ` · logged ${it.at.toLocaleString('en-GB', {day:'numeric', month:'short', hour:'2-digit', minute:'2-digit'})}` : '';
    return `<div class="sl-row" data-wk="${it.w.wk}">
      <span class="day-badge ${dayCls[it.meta[0]]}">${it.meta[1]}</span>
      <div class="sl-main"><div class="sl-title">${it.title}</div><div class="sl-sub">Wk ${it.w.wk} · ${it.w.phase} · ${dStr}${logged}</div></div>
      ${it.lift ? `<div class="sl-lift">${it.lift}</div>` : ''}
      <svg class="sl-tick" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><circle cx="12" cy="12" r="10"/><path d="M8 12l3 3 5-6"/></svg>
    </div>`;
  }).join('') + (items.length > LIMIT ? `<button type="button" class="btn btn-sm" id="sl-toggle" style="margin-top:12px;">${sessionLogShowAll ? 'Show fewer' : `Show all ${items.length}`}</button>` : '');
  el.querySelectorAll('.sl-row').forEach(r=>r.onclick = ()=>goToWeekView(+r.dataset.wk));
  const tg = document.getElementById('sl-toggle');
  if(tg) tg.onclick = ()=>{ sessionLogShowAll = !sessionLogShowAll; renderSessionLog(); };
}

// ==================== FIXTURES ====================
function renderFixtures(filter){
  filter = filter || document.getElementById('fx-filter').value;
  const list = document.getElementById('fixtures-list');
  list.innerHTML = '';
  let played=0, wins=0, losses=0, draws=0;
  const nextFx = findNextFixture();
  DATA.fixtures.forEach(f=>{
    const st = fxStatus(f);
    if(f.result){
      played++;
      if(f.result[0]==='W') wins++; else if(f.result[0]==='L') losses++; else draws++;
    }
    let show = true;
    if(filter==='H') show = f.venue==='H';
    else if(filter==='A') show = f.venue==='A';
    else if(filter==='played') show = st==='played' || st==='pending';
    else if(filter==='upcoming') show = st==='upcoming' || st==='today';
    if(!show) return;
    const row = document.createElement('div');
    row.className = 'fixture-row' + (f===nextFx ? ' next' : '');
    let resHtml;
