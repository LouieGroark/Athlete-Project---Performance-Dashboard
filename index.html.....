  {key: 'front-squat',         name: 'Front Squat',          cat: 'strength', mode: 'e1rm'},
  {key: 'incline-bench',       name: 'Incline Bench',        cat: 'strength', mode: 'e1rm'},
  {key: 'close-grip-bench',    name: 'Close-Grip Bench',     cat: 'strength', mode: 'e1rm'},
  {key: 'overhead-press',      name: 'Overhead Press',       cat: 'strength', mode: 'e1rm'},
  {key: 'deadlift',            name: 'Deadlift',             cat: 'strength', mode: 'e1rm'},
  {key: 'power-clean',         name: 'Power Clean',          cat: 'power',    mode: 'e1rm'},
  {key: 'hang-power-clean',    name: 'Hang Power Clean',     cat: 'power',    mode: 'e1rm'},
