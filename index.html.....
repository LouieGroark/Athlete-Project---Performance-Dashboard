function renderMesocycleChart(){
  const el = document.getElementById('mesocycle-chart');
  const blocks = DATA.block_table;
  const series = {build:[], peak:[], regen:[]};
  blocks.forEach(r=>{ series.build.push(parsePct(r[2])); series.peak.push(parsePct(r[3])); series.regen.push(parsePct(r[4])); });
  const all = [...series.build, ...series.peak, ...series.regen].filter(v=>v!=null);
  const min = Math.min(...all)-3, max = Math.max(...all)+3;
  const W=680, H=210, padL=36, padB=26, padT=10, padR=10;
  const plotW = W-padL-padR, plotH = H-padT-padB;
  const n = blocks.length;
  const x = i => padL + (n===1?0:i/(n-1))*plotW;
  const y = v => padT + plotH - ((v-min)/(max-min))*plotH;
  function pathFor(arr){
    let d = ''; let started=false;
    arr.forEach((v,i)=>{ if(v==null) return; d += (started?' L ':'M ')+x(i).toFixed(1)+' '+y(v).toFixed(1); started=true; });
    return d;
  }
  function dotsFor(arr,color){
    return arr.map((v,i)=> v==null?'':`<circle cx="${x(i).toFixed(1)}" cy="${y(v).toFixed(1)}" r="3.2" fill="${color}"/>`).join('');
  }
  let gridY = '';
  for(let g=0; g<=2; g++){
    const v = min + (max-min)*g/2;
    gridY += `<line x1="${padL}" y1="${y(v).toFixed(1)}" x2="${W-padR}" y2="${y(v).toFixed(1)}" stroke="var(--line)" stroke-width="1"/>
      <text x="${padL-6}" y="${(y(v)+3).toFixed(1)}" text-anchor="end" font-size="10" fill="var(--muted2)">${Math.round(v)}%</text>`;
  }
  let xLabels = blocks.map((r,i)=>`<text x="${x(i).toFixed(1)}" y="${H-6}" text-anchor="middle" font-size="9.5" fill="var(--muted2)">${r[0].split(' ')[0]+' '+r[0].split(' ')[1]}</text>`).join('');
  el.innerHTML = `<svg viewBox="0 0 ${W} ${H}" width="100%" style="display:block;">
    ${gridY}
    <path d="${pathFor(series.build)}" fill="none" stroke="var(--blue)" stroke-width="2"/>
    <path d="${pathFor(series.peak)}" fill="none" stroke="var(--amber)" stroke-width="2"/>
    <path d="${pathFor(series.regen)}" fill="none" stroke="var(--violet)" stroke-width="2"/>
    ${dotsFor(series.build,'var(--blue)')}
    ${dotsFor(series.peak,'var(--amber)')}
    ${dotsFor(series.regen,'var(--violet)')}
    ${xLabels}
  </svg>
  <div style="display:flex;gap:16px;margin-top:6px;font-size:11.5px;color:var(--muted);">
    <span><span style="display:inline-block;width:9px;height:9px;border-radius:2px;background:var(--blue);margin-right:5px;"></span>Build %1RM</span>
    <span><span style="display:inline-block;width:9px;height:9px;border-radius:2px;background:var(--amber);margin-right:5px;"></span>Peak %1RM</span>
    <span><span style="display:inline-block;width:9px;height:9px;border-radius:2px;background:var(--violet);margin-right:5px;"></span>Regen %1RM</span>
  </div>`;
}
