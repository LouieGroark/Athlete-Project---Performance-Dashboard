renderExFilters();
renderExBank('');
renderTesting();
renderCoachingHub();

// mobile menu
const menuBtn = document.createElement('div');
menuBtn.id = 'menuBtn';
menuBtn.innerHTML = '☰';
menuBtn.style.cssText = 'position:fixed;top:14px;left:14px;z-index:60;background:var(--panel);border:1px solid var(--line);border-radius:2px;';
menuBtn.onclick = ()=>document.getElementById('sidebar').classList.toggle('open');
document.body.appendChild(menuBtn);

// expose the handful of functions referenced by inline onclick="" in the
// markup above, since they now live inside runApp()'s local scope
window.goToWeekView = goToWeekView;
window.jumpToPhaseWeeks = jumpToPhaseWeeks;
window.setWeek = setWeek;
window.stepWeek = stepWeek;

// expose the storage bridge so the auth/sync script below can call back in
window.__dashboardSaveLocal = saveLocal;
} // end runApp
