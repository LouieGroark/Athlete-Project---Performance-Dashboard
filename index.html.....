<script>
// ============================================================
// AUTH + CLOUD SYNC + PROGRAMME LOADING
// Fill these two in from Supabase: Project Settings > API
// ============================================================
const SUPABASE_URL = 'https://bcfkggtxfzmbhghfcigd.supabase.co';
const SUPABASE_ANON_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJjZmtnZ3R4ZnptYmhnaGZjaWdkIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTAwNTc5MTIsImV4cCI6MjEwNTYzMzkxMn0.cGsjrFJ6X7mZVhaYd-BwNTfrVnez8Bw3WlEGRxzsiWg';

// Supabase Auth is email-based under the hood, but the login page only asks
// for a username. Each username becomes username@EMAIL_DOMAIN internally —
// invisible to the user, never shown anywhere in the UI.
const EMAIL_DOMAIN = 'users.athlete-project.local';
const usernameToEmail = (u) => `${u.trim().toLowerCase()}@${EMAIL_DOMAIN}`;

const supa = (SUPABASE_URL.startsWith('http'))
  ? window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY)
  : null;

// Fallback so the file still opens and works before Supabase is configured.
const BUNDLED_PROGRAMME = JSON.parse(document.getElementById('app-data').textContent);

let authMode = 'signin'; // 'signin' | 'signup'
let currentUserId = null;
let pendingUser = null;       // set while the account-setup screen is showing
let sportPackCache = {};      // sport -> full programmes.data payload, fetched once per sport per session

// ---------- background sync: local write -> cloud write ----------
window.__syncToCloud = async function(key, val){
  if(!supa || !currentUserId) return;
  try{
    await supa.from('user_data').upsert({
      user_id: currentUserId,
      key: key,
      value: val,
      updated_at: new Date().toISOString()
    }, { onConflict: 'user_id,key' });
  }catch(e){ console.warn('cloud sync failed for', key, e); }
};

// ---------- pull every saved key for this user before the app boots ----------
async function preloadCloudData(userId){
  if(!supa) return;
  const { data, error } = await supa.from('user_data').select('key,value').eq('user_id', userId);
  if(error || !data) return;
  data.forEach(row => {
    try{ localStorage.setItem(row.key, JSON.stringify(row.value)); }catch(e){}
  });
}

// ---------- fetch (and cache) a sport's full programme pack ----------
async function fetchSportPack(sport){
  if(!sport) return null;
  if(sportPackCache[sport]) return sportPackCache[sport];
  if(!supa) return null;
  try{
    const { data, error } = await supa.from('programmes').select('data').eq('sport', sport).maybeSingle();
    if(error || !data) return null;
    sportPackCache[sport] = data.data;
    return data.data;
  }catch(e){
    console.warn('could not load sport pack for', sport, e);
    return null;
  }
}

// ---------- club fixtures ----------
async function fetchClubFixtures(clubName){
  if(!supa || !clubName) return null;
  try{
    const { data } = await supa.from('clubs').select('fixtures').ilike('name', clubName.trim()).maybeSingle();
    return (data && data.fixtures && data.fixtures.length) ? data.fixtures : null;
  }catch(e){ return null; }
}

// ---------- build the DATA object the dashboard renders from a sport pack ----------
// Football/Netball packs don't yet have curated reference material (phase
// cards, exercise bank, S&C templates, tier/block tables) the way rugby
// does — only rugby's workbook included those sheets. Without these safe
// empty defaults, pages that .forEach()/.map() over them would throw on
// undefined and silently stop the whole app from rendering, including the
// actual weekly sessions. Real reference content for those two sports can
// be layered in later without any other code changes.
const SAFE_SHARED_DEFAULTS = {
  phases: [], exbank: [], sc_sessions: [], day_sections: [],
  tier_table: [], block_table: [], testing_metrics: []
};
// A generic, sport-agnostic testing battery used whenever a sport pack has
// no curated testing_metrics of its own (currently: football, netball).
const GENERIC_TESTING_METRICS = [
  'Anthropometry / Body Composition',
  'Maximal Strength (Squat / Bench equivalents)',
  '10m / 20m Sprint Speed',
  'Change of Direction (505 / T-Test)',
  'Vertical Jump (CMJ)',
  'Repeat Sprint Ability / Aerobic Capacity (Yo-Yo IR1)'
];

function assembleProgrammeData(pack, position, goal, clubFixtures){
  if(!pack) return BUNDLED_PROGRAMME;
  const posEntry = pack.positions && pack.positions[position];
  const goalEntry = posEntry ? (posEntry[goal] || posEntry['default']) : null;
  const weeks = goalEntry ? goalEntry.weeks : (BUNDLED_PROGRAMME.weeks || []);
  const shared = Object.assign({}, SAFE_SHARED_DEFAULTS, pack.shared || {});
  if(!shared.testing_metrics.length) shared.testing_metrics = GENERIC_TESTING_METRICS;
  return Object.assign(
    {},
    shared,
    { weeks: weeks, fixtures: clubFixtures || pack.fixtures || [] }
  );
}

// ---------- populate a <select> of positions for a given sport pack ----------
function populatePositionSelect(selectEl, pack, selectedValue){
  const options = (pack && pack.position_options) || [];
  selectEl.innerHTML = options.map(o => `<option value="${o.value}">${o.label}</option>`).join('');
  if(selectedValue) selectEl.value = selectedValue;
  selectEl.disabled = options.length === 0;
}
function positionHasGoals(pack, position){
  const opt = pack && pack.position_options && pack.position_options.find(o => o.value === position);
  return opt ? !!opt.hasGoals : true;
}

// ---------- get (or wait for) this user's profile row ----------
async function loadProfile(userId){
  if(!supa) return null;
  for(let i=0;i<5;i++){
    const { data } = await supa.from('profiles').select('*').eq('id', userId).maybeSingle();
    if(data) return data;
    await new Promise(res => setTimeout(res, 400)); // profile trigger may lag by a beat right after sign-up
  }
  return null;
}

// ---------- boot the actual dashboard once we know who's signed in and set up ----------
async function startDashboard(user, profile){
  currentUserId = user.id;
  profile = profile || await loadProfile(user.id);
  await preloadCloudData(user.id);

  const pack = await fetchSportPack(profile && profile.sport);
  const clubFixtures = (profile && profile.club_name) ? await fetchClubFixtures(profile.club_name) : null;
  const programmeData = assembleProgrammeData(pack, profile && profile.position, profile && profile.goal, clubFixtures);

  document.getElementById('identityName').textContent = (profile && profile.username) || user.email;
  document.getElementById('identitySub').textContent = profile ? [profile.position, profile.sport].filter(Boolean).map(s=>s.charAt(0).toUpperCase()+s.slice(1)).join(' — ') : 'Performance Dashboard';

  document.getElementById('authGate').style.display = 'none';
  document.getElementById('setupGate').style.display = 'none';
  document.getElementById('app').style.display = '';

  await runApp(programmeData, profile && profile.club_name);
}

// ---------- route a freshly-authed user to setup or straight to the dashboard ----------
async function routeAfterAuth(user){
  const profile = await loadProfile(user.id);
  if(!profile || !profile.setup_complete){
    pendingUser = user;
    document.getElementById('authGate').style.display = 'none';
    document.getElementById('setupGate').style.display = '';
  } else {
    await startDashboard(user, profile);
  }
}

// ---------- identity chip opens Settings ----------
const settingsModal = document.getElementById('settingsModal');
document.getElementById('identityChip').removeAttribute('title');
document.getElementById('identityChip').addEventListener('click', () => openSettings());
document.getElementById('settingsClose').addEventListener('click', () => settingsModal.style.display = 'none');

async function openSettings(){
  if(!supa || !currentUserId) return;
  const profile = await loadProfile(currentUserId);
  if(!profile) return;

  document.getElementById('settingsUsername').textContent = profile.username || '';
  document.getElementById('setSport').value = profile.sport || 'rugby';
  document.getElementById('setHasClub').value = profile.club_name ? 'yes' : 'no';
  document.getElementById('setClubWrap').style.display = profile.club_name ? '' : 'none';
  document.getElementById('setClubName').value = profile.club_name || '';

  const pack = await fetchSportPack(profile.sport);
  populatePositionSelect(document.getElementById('setPosition'), pack, profile.position);
  document.getElementById('setGoalWrap').style.display = positionHasGoals(pack, profile.position) ? '' : 'none';
  document.getElementById('setGoal').value = profile.goal || 'SP-P';

  document.getElementById('settingsError').style.display = 'none';
  settingsModal.style.display = '';
}

document.getElementById('setSport').addEventListener('change', async (e) => {
  const pack = await fetchSportPack(e.target.value);
  const posSel = document.getElementById('setPosition');
  populatePositionSelect(posSel, pack, null);
  document.getElementById('setGoalWrap').style.display = positionHasGoals(pack, posSel.value) ? '' : 'none';
});
document.getElementById('setPosition').addEventListener('change', async (e) => {
  const pack = await fetchSportPack(document.getElementById('setSport').value);
  document.getElementById('setGoalWrap').style.display = positionHasGoals(pack, e.target.value) ? '' : 'none';
});
document.getElementById('setHasClub').addEventListener('change', (e) => {
  document.getElementById('setClubWrap').style.display = (e.target.value === 'yes') ? '' : 'none';
});

document.getElementById('settingsForm').addEventListener('submit', async (e) => {
  e.preventDefault();
  const err = document.getElementById('settingsError');
  err.style.display = 'none';

  const sport = document.getElementById('setSport').value;
  const position = document.getElementById('setPosition').value;
  const hasGoals = positionHasGoals(await fetchSportPack(sport), position);
  const goal = hasGoals ? document.getElementById('setGoal').value : null;
  const hasClub = document.getElementById('setHasClub').value === 'yes';
  const clubName = hasClub ? document.getElementById('setClubName').value.trim() : null;

  try{
    const { error } = await supa.from('profiles').update({ sport, position, goal, club_name: clubName }).eq('id', currentUserId);
    if(error) throw error;
    settingsModal.style.display = 'none';
    location.reload(); // simplest reliable way to re-render every page with the new programme
  }catch(err2){
    err.textContent = err2.message || 'Could not save changes.';
    err.style.display = 'block';
  }
});

document.getElementById('settingsSignOutBtn').addEventListener('click', async () => {
  if(!supa) return;
  if(confirm('Sign out?')){
    await supa.auth.signOut();
    location.reload();
  }
});

// ---------- auth form wiring ----------
const authForm = document.getElementById('authForm');
const authError = document.getElementById('authError');
const authSubmitBtn = document.getElementById('authSubmitBtn');
const authSub = document.getElementById('authSub');
const authToggleMode = document.getElementById('authToggleMode');

function showAuthError(msg){
  authError.textContent = msg;
  authError.style.display = 'block';
  authError.style.background = 'var(--red-soft)';
  authError.style.color = 'var(--red)';
}

authToggleMode.addEventListener('click', () => {
  authMode = (authMode === 'signin') ? 'signup' : 'signin';
  authSubmitBtn.textContent = (authMode === 'signup') ? 'Create account' : 'Sign in';
  authSub.textContent = (authMode === 'signup') ? 'Create your account' : 'Sign in to your dashboard';
  authToggleMode.textContent = (authMode === 'signup') ? 'Already have an account? Sign in' : "Don't have an account? Sign up";
  authError.style.display = 'none';
});

authForm.addEventListener('submit', async (e) => {
  e.preventDefault();
  authError.style.display = 'none';
  if(!supa){ showAuthError('Supabase is not configured yet — fill in SUPABASE_URL and SUPABASE_ANON_KEY.'); return; }

  const username = document.getElementById('authUsername').value.trim();
  const password = document.getElementById('authPassword').value;
  authSubmitBtn.disabled = true;

  try{
    if(authMode === 'signup'){
      const email = usernameToEmail(username);
      const { data, error } = await supa.auth.signUp({ email, password, options: { data: { username } } });
      if(error) throw error;
      if(data.user && !data.session){
        showAuthError('Account created — sign-in should work immediately. If not, email confirmation may be on for this project — turn it off in Supabase Auth settings, since these accounts use a placeholder email.');
        authSubmitBtn.disabled = false;
        return;
      }
      if(data.session) await routeAfterAuth(data.user);
    } else {
      const { data: email, error: lookupErr } = await supa.rpc('get_email_by_username', { uname: username });
      if(lookupErr || !email) throw new Error('No account found for that username.');
      const { data, error } = await supa.auth.signInWithPassword({ email, password });
      if(error) throw error;
      await routeAfterAuth(data.user);
    }
  }catch(err){
    showAuthError(err.message || 'Something went wrong.');
    authSubmitBtn.disabled = false;
  }
});

// ---------- account-setup form wiring ----------
const setupForm = document.getElementById('setupForm');
const setupError = document.getElementById('setupError');
const setupSubmitBtn = document.getElementById('setupSubmitBtn');
const setupSportSel = document.getElementById('setupSport');
const setupPositionSel = document.getElementById('setupPosition');
const setupGoalWrap = document.getElementById('setupGoalWrap');
const setupHasClubSel = document.getElementById('setupHasClub');
const setupClubWrap = document.getElementById('setupClubWrap');

setupSportSel.addEventListener('change', async () => {
  const sport = setupSportSel.value;
  if(!sport){
    setupPositionSel.innerHTML = '<option value="">Select a sport first…</option>';
    setupPositionSel.disabled = true;
    setupSubmitBtn.disabled = true;
    return;
  }
  setupPositionSel.innerHTML = '<option value="">Loading positions…</option>';
  const pack = await fetchSportPack(sport);
  if(!pack){
    setupError.textContent = 'That sport isn\u2019t set up in the database yet — ask your admin to run seed-programmes.sql.';
    setupError.style.display = 'block';
    setupPositionSel.innerHTML = '<option value="">Not available</option>';
    setupPositionSel.disabled = true;
    setupSubmitBtn.disabled = true;
    return;
  }
  setupError.style.display = 'none';
  populatePositionSelect(setupPositionSel, pack, null);
  setupGoalWrap.style.display = positionHasGoals(pack, setupPositionSel.value) ? '' : 'none';
  setupSubmitBtn.disabled = false;
});

setupPositionSel.addEventListener('change', async () => {
  const pack = await fetchSportPack(setupSportSel.value);
  setupGoalWrap.style.display = positionHasGoals(pack, setupPositionSel.value) ? '' : 'none';
});

setupHasClubSel.addEventListener('change', () => {
  setupClubWrap.style.display = (setupHasClubSel.value === 'yes') ? '' : 'none';
});

setupForm.addEventListener('submit', async (e) => {
  e.preventDefault();
  setupError.style.display = 'none';
  setupSubmitBtn.disabled = true;

  const sport = setupSportSel.value;
  const position = setupPositionSel.value;
  const pack = await fetchSportPack(sport);
  const hasGoals = positionHasGoals(pack, position);
  const goal = hasGoals ? document.getElementById('setupGoal').value : null;
  const hasClub = setupHasClubSel.value === 'yes';
  const clubName = hasClub ? document.getElementById('setupClubName').value.trim() : null;

  try{
    const { error } = await supa.from('profiles').update({
      sport, position, goal, club_name: clubName, setup_complete: true
    }).eq('id', pendingUser.id);
    if(error) throw error;

    const profile = await loadProfile(pendingUser.id);
    await startDashboard(pendingUser, profile);
  }catch(err){
    setupError.textContent = err.message || 'Something went wrong loading your programme.';
    setupError.style.display = 'block';
    setupSubmitBtn.disabled = false;
  }
});

// ---------- on load: resume an existing session, or show the gate ----------
(async function initAuth(){
  if(!supa){
    showAuthError('Supabase is not configured yet — fill in SUPABASE_URL and SUPABASE_ANON_KEY near the bottom of this file. Showing the bundled demo data for now.');
    document.getElementById('authGate').style.display = 'none';
    document.getElementById('app').style.display = '';
    await runApp(BUNDLED_PROGRAMME, 'Billingham');
    return;
  }
  const { data: { session } } = await supa.auth.getSession();
  if(session && session.user){
    await routeAfterAuth(session.user);
  }
})();
</script>
