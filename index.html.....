  {key: 'broad-jump',          name: 'Broad Jump',           cat: 'power',    mode: 'distance'},
  {key: 'cmj',                 name: 'Countermovement Jump', cat: 'power',    mode: 'distance'}
];
const ptExOrder = key => { const i = PT_EXERCISES.findIndex(x => x.key === key); return i < 0 ? 999 : i; };
const ptMetric = e => e.mode === 'distance' ? e.cm : e.mode === 'load' ? e.kg : (e.reps > 1 ? e.kg * (1 + e.reps / 30) : e.kg);
const ptVolume = e => e.mode === 'distance' ? 0 : e.kg * e.sets * e.reps;
const ptUnit = e => e.mode === 'distance' ? 'cm' : 'kg';

// ---- calculations ----
function ptGroupBy(arr, fn){
  const m = new Map();
  arr.forEach(x => { const k = fn(x); if(!m.has(k)) m.set(k, []); m.get(k).push(x); });
  return m;
}
// best result per plan week for one exercise -> Map(week -> value)
function ptBestByWeek(entries){
  const m = new Map();
  entries.forEach(e => { const w = ptWeek(e.date), v = ptMetric(e); if(!m.has(w) || v > m.get(w)) m.set(w, v); });
  return m;
}
// last value logged in each plan week -> Map(week -> {value, date})
function ptWeeklyLatest(list, valueFn){
  const m = new Map();
  [...list].sort(ptByDate).forEach(e => m.set(ptWeek(e.date), {value: valueFn(e), date: e.date}));
  return m;
}
// Strength / Power: for each exercise logged in the most recent logged week, compare its best
// result that week with its best in the last earlier week it was logged; average the % changes.
function ptCategoryChange(cat){
  const es = liftLog.filter(e => e.cat === cat);
  if(!es.length) return {state: 'empty', rows: []};
  const L = Math.max(...es.map(e => ptWeek(e.date)));
  const rows = [];
  ptGroupBy(es, e => e.exKey).forEach((list, key) => {
    const m = ptBestByWeek(list);
    if(!m.has(L)) return;
    const earlier = [...m.keys()].filter(w => w < L);
    if(!earlier.length) return;
    const P = Math.max(...earlier), cur = m.get(L), prev = m.get(P);
    rows.push({key, name: list[0].exName, unit: ptUnit(list[0]), L, P, cur, prev, diff: cur - prev, pct: (cur - prev) / prev * 100});
  });
  if(!rows.length) return {state: 'need2', L, rows};
  rows.sort((a, b) => ptExOrder(a.key) - ptExOrder(b.key) || a.name.localeCompare(b.name));
  const avg = rows.reduce((s, r) => s + r.pct, 0) / rows.length;
  return {state: 'ok', L, P: rows.every(r => r.P === rows[0].P) ? rows[0].P : null, rows, avg};
}
// Body weight: last weigh-in of the most recent logged week vs the last weigh-in of the week before it.
function ptBodyWeightChange(){
  if(!bwLog.length) return {state: 'empty'};
  const m = ptWeeklyLatest(bwLog, e => e.kg), weeks = [...m.keys()].sort((a, b) => a - b);
  const L = weeks[weeks.length - 1], cur = m.get(L).value;
  if(weeks.length < 2) return {state: 'need2', L, cur};
  const P = weeks[weeks.length - 2], prev = m.get(P).value;
  return {state: 'ok', L, P, cur, prev, pct: (cur - prev) / prev * 100};
}
// Hypertrophy: lean muscle mass vs fat mass from the latest manual entry, and the change since the one before.
function ptCompSummary(){
  if(!compLog.length) return {state: 'empty'};
  const s = [...compLog].sort(ptByDate), cur = s[s.length - 1], prev = s.length > 1 ? s[s.length - 2] : null;
  return {state: 'ok', cur, prev, ratio: cur.lean / cur.fat, fatPct: cur.fat / (cur.lean + cur.fat) * 100};
}

// ---- weeks shown in the trend charts ----
function ptWindowWeeks(){
  const n = +document.getElementById('progress-window').value;
  const logged = [...liftLog, ...bwLog, ...compLog].map(e => ptWeek(e.date));
  const hi = Math.max(currentWeekObj.wk, ...logged);
  let lo = n === 999 ? (logged.length ? Math.min(...logged) : hi - 7) : hi - n + 1;
  lo = Math.max(1, Math.min(lo, hi - 3));
  const out = [];
  for(let w = lo; w <= hi; w++) out.push(w);
  return out;
}
const ptLiftSeries = (key, weeks) => { const ks = [].concat(key), m = ptBestByWeek(liftLog.filter(e => ks.includes(e.exKey))); return weeks.map(w => ({wk: w, value: m.has(w) ? m.get(w) : null})); };
function ptVolumeSeries(weeks){
  const m = new Map();
  liftLog.forEach(e => { const v = ptVolume(e); if(v){ const w = ptWeek(e.date); m.set(w, (m.get(w) || 0) + v); } });
  return weeks.map(w => ({wk: w, value: m.has(w) ? m.get(w) : null}));
}
function ptBwSeries(weeks){
  const m = ptWeeklyLatest(bwLog, e => e.kg);
  return weeks.map(w => ({wk: w, value: m.has(w) ? m.get(w).value : null}));
}

