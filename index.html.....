// ---- log modal (opened from the boxes above) ----
const ptOverlay = document.getElementById('pt-overlay'), ptModal = document.getElementById('pt-modal');
const $m = sel => ptModal.querySelector(sel);
let ptOpenType = null, ptReturnFocus = null;

function ptModalShell(title, help, body){
  return `<div class="pt-mhead"><h3 id="pt-modal-title">${title}</h3><button type="button" class="pt-x" id="pt-close" aria-label="Close">×</button></div>
    <p class="pt-help">${help}</p>${body}`;
}
function ptMsg(text, isErr){ const el = $m('#pt-msg'); el.textContent = text; el.className = 'pt-msg ' + (isErr ? 'err' : 'ok'); }
function ptWireDelete(container, onDelete){
  container.querySelectorAll('.pt-del').forEach(btn => btn.onclick = () => {
    if(btn.dataset.armed){ onDelete(btn.dataset.id); return; }
    btn.dataset.armed = '1'; btn.classList.add('armed'); btn.textContent = 'Sure?';
    setTimeout(() => { if(btn.isConnected){ delete btn.dataset.armed; btn.classList.remove('armed'); btn.textContent = 'Delete'; } }, 3000);
  });
}
function ptEntryRows(items, describe){
  if(!items.length) return '<div class="pt-entry"><span class="none">No entries yet.</span></div>';
  return items.map(e => `<div class="pt-entry"><div><div>${describe(e)}</div><div class="meta">${ptDay(e.date)} · Wk ${ptWeek(e.date)}</div></div><button type="button" class="pt-del" data-id="${e.id}">Delete</button></div>`).join('');
}
function ptRecent(list){
  return list.map((e, i) => ({e, i})).sort((a, b) => (b.e.date < a.e.date ? -1 : b.e.date > a.e.date ? 1 : 0) || b.i - a.i).slice(0, 6).map(x => x.e);
}
function ptOpenModal(type, preKey){
  ptOpenType = type;
  ptReturnFocus = document.activeElement;
  if(type === 'strength' || type === 'power') ptBuildLiftModal(type, preKey);
  else if(type === 'bodyweight') ptBuildBwModal();
  else if(type === 'hypertrophy') ptBuildCompModal();
  else return;
  ptOverlay.hidden = false;
  document.body.style.overflow = 'hidden';
  const first = ptModal.querySelector('input:not([hidden]),select'); if(first) first.focus();
  $m('#pt-close').onclick = ptCloseModal;
  const done = $m('#pt-done'); if(done) done.onclick = ptCloseModal;
}
function ptCloseModal(){
  const type = ptOpenType;
  ptOverlay.hidden = true; document.body.style.overflow = ''; ptOpenType = null;
  const back = ptReturnFocus && ptReturnFocus.isConnected ? ptReturnFocus : document.querySelector(`[data-open="${type}"]`);
  if(back) back.focus();
}
ptOverlay.addEventListener('mousedown', e => { if(e.target === ptOverlay) ptCloseModal(); });
document.addEventListener('keydown', e => { if(e.key === 'Escape' && !ptOverlay.hidden) ptCloseModal(); });
ptModal.addEventListener('keydown', e => {
  if(e.key !== 'Tab') return;
  const f = [...ptModal.querySelectorAll('button,input,select')].filter(el => !el.disabled && el.offsetParent !== null);
  if(!f.length) return;
  if(e.shiftKey && document.activeElement === f[0]){ e.preventDefault(); f[f.length - 1].focus(); }
  else if(!e.shiftKey && document.activeElement === f[f.length - 1]){ e.preventDefault(); f[0].focus(); }
});

function ptDateField(){
  return `<div class="pt-field"><label for="pt-date">Date</label><input type="date" id="pt-date" value="${ptToday()}" min="${ptIso(PT_START)}" max="${ptIso(PT_END)}"></div>`;
}

// Strength and Power share one form; the box you clicked decides which exercises are offered.
function ptBuildLiftModal(cat, preKey){
  const isStr = cat === 'strength';
  const opts = PT_EXERCISES.filter(x => x.cat === cat);
  const sel = opts.some(o => o.key === preKey) ? preKey : opts[0].key;
  ptModal.innerHTML = ptModalShell(
    isStr ? 'Log a strength lift' : 'Log a power exercise',
    isStr ? 'Log your best working set. Strength compares each lift’s best estimated 1RM this week with the last week you logged it.'
          : 'Log your best set or jump. Power compares each exercise’s best this week with the last week you logged it.',
    `${ptDateField()}
    <div class="pt-field"><label for="pt-ex">Exercise</label><select id="pt-ex">${opts.map(o => `<option value="${o.key}"${o.key === sel ? ' selected' : ''}>${o.name}</option>`).join('')}<option value="__other">Other…</option></select></div>
    <div class="pt-field" id="pt-custom" hidden>
      <label for="pt-cname">Exercise name</label><input type="text" id="pt-cname" maxlength="40" placeholder="${isStr ? 'e.g. Trap Bar Deadlift' : 'e.g. Medicine Ball Throw'}">
      ${isStr ? '' : '<label for="pt-cmode" style="margin-top:8px;">Measured as</label><select id="pt-cmode"><option value="e1rm">Weight × reps</option><option value="distance">Distance or height (cm)</option></select>'}
    </div>
    <div class="pt-row3" id="pt-loadf">
      <div class="pt-field"><label for="pt-kg">Weight (kg)</label><input type="number" id="pt-kg" min="0.5" max="700" step="0.5" inputmode="decimal"></div>
      <div class="pt-field"><label for="pt-sets">Sets</label><input type="number" id="pt-sets" min="1" max="20" step="1" value="3" inputmode="numeric"></div>
      <div class="pt-field"><label for="pt-reps">Reps</label><input type="number" id="pt-reps" min="1" max="30" step="1" inputmode="numeric"></div>
    </div>
    <div class="pt-field" id="pt-distf" hidden><label for="pt-cm">Best distance or height (cm)</label><input type="number" id="pt-cm" min="1" max="1000" step="0.5" inputmode="decimal"></div>
    <div class="pt-preview" id="pt-preview"></div>
    <div class="pt-msg" id="pt-msg" role="status" aria-live="polite"></div>
    <div class="pt-actions"><button type="button" id="pt-done">Done</button><button type="button" class="btn-primary" id="pt-save">Save entry</button></div>
    <div class="pt-entries"><h4>Recent entries</h4><div id="pt-entries"></div></div>`);

  const exSel = $m('#pt-ex');
  const mode = () => exSel.value === '__other' ? (isStr ? 'e1rm' : $m('#pt-cmode').value) : PT_EXERCISES.find(x => x.key === exSel.value).mode;
  function preview(){
    const m = mode(), kg = +$m('#pt-kg').value, sets = +$m('#pt-sets').value, reps = +$m('#pt-reps').value;
    let t = '';
    if(m === 'e1rm' && kg > 0 && reps > 0) t = `Estimated 1RM ${ptFmt(reps > 1 ? kg * (1 + reps / 30) : kg)} kg` + (sets > 0 ? ` · volume ${ptFmt(kg * sets * reps, 0)} kg` : '');
    else if(m === 'load' && kg > 0) t = `Load ${ptFmt(kg)} kg` + (sets > 0 && reps > 0 ? ` · volume ${ptFmt(kg * sets * reps, 0)} kg` : '');
    $m('#pt-preview').textContent = t;
  }
  function sync(){
    $m('#pt-custom').hidden = exSel.value !== '__other';
    $m('#pt-loadf').hidden = mode() === 'distance';
    $m('#pt-distf').hidden = mode() !== 'distance';
    preview();
  }
  function list(){
    const box = $m('#pt-entries');
    box.innerHTML = ptEntryRows(ptRecent(liftLog.filter(e => e.cat === cat)), e => {
      const desc = e.mode === 'distance' ? `${ptFmt(e.cm)} cm` : `${e.sets}×${e.reps} @ ${ptFmt(e.kg)} kg` + (e.mode === 'e1rm' && e.reps > 1 ? ` · est. 1RM ${ptFmt(ptMetric(e))} kg` : '');
      return `<b>${ptEsc(e.exName)}</b> · ${desc}`;
    });
    ptWireDelete(box, id => { liftLog = liftLog.filter(e => e.id !== id); ptSave(); renderProgress(); list(); });
  }
  exSel.onchange = sync;
  if(!isStr) $m('#pt-cmode').onchange = sync;
  ['#pt-kg', '#pt-sets', '#pt-reps'].forEach(s => $m(s).oninput = preview);
  $m('#pt-save').onclick = () => {
    const date = $m('#pt-date').value;
    if(!ptOkDate(date)) return ptMsg('Pick a date.', true);
    let x = null, exKey, exName, m;
    if(exSel.value === '__other'){
      const nm = $m('#pt-cname').value.trim();
      if(!nm) return ptMsg('Enter the exercise name.', true);
      x = PT_EXERCISES.find(p => p.cat === cat && p.name.toLowerCase() === nm.toLowerCase());
      if(x){ exKey = x.key; exName = x.name; m = x.mode; }
      else {
        exKey = 'custom:' + nm.toLowerCase(); m = mode();
        const prior = liftLog.find(p => p.exKey === exKey);
        exName = prior ? prior.exName : nm;
        if(prior && (prior.mode === 'distance') !== (m === 'distance')) return ptMsg(`${prior.exName} was logged as ${prior.mode === 'distance' ? 'a distance or height' : 'weight × reps'} — keep the same measure.`, true);
      }
    } else { x = PT_EXERCISES.find(p => p.key === exSel.value); exKey = x.key; exName = x.name; m = x.mode; }
    const e = {id: ptId(), date, cat, exKey, exName, mode: m};
    if(m === 'distance'){
      const cm = +$m('#pt-cm').value;
      if(!(cm > 0)) return ptMsg('Enter the distance or height in cm.', true);
      e.cm = cm;
    } else {
      const kg = +$m('#pt-kg').value, sets = +$m('#pt-sets').value, reps = +$m('#pt-reps').value;
      if(!(kg > 0)) return ptMsg('Enter the weight in kg.', true);
      if(!(Number.isInteger(sets) && sets >= 1)) return ptMsg('Sets must be a whole number of 1 or more.', true);
      if(!(Number.isInteger(reps) && reps >= 1)) return ptMsg('Reps must be a whole number of 1 or more.', true);
      e.kg = kg; e.sets = sets; e.reps = reps;
    }
    liftLog.push(e); ptSave(); renderProgress(); list();
    $m('#pt-kg').value = ''; $m('#pt-reps').value = ''; $m('#pt-cm').value = ''; preview();
    ptMsg(`Saved ${exName} for Wk ${ptWeek(date)}.`, false);
  };
  sync(); list();
}

