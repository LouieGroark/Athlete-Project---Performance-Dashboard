// ---- dates: entries are grouped into the same Monday-start weeks as the plan ----
const PT_START = parseDate(DATA.weeks[0].date);
const PT_END = new Date(PT_START.getFullYear(), PT_START.getMonth(), PT_START.getDate() + DATA.weeks.length * 7 - 1);
const ptIso = d => d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
const ptDate = s => { const [y, m, d] = s.split('-').map(Number); return new Date(y, m - 1, d); };
const ptWeek = iso => Math.floor(Math.round((ptDate(iso) - PT_START) / 864e5) / 7) + 1;
const PT_MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'], PT_DOW = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
const ptShortDay = iso => { const d = ptDate(iso); return d.getDate() + ' ' + PT_MONTHS[d.getMonth()]; };
const ptDay = iso => PT_DOW[ptDate(iso).getDay()] + ' ' + ptShortDay(iso);
function ptToday(){
  const t = new Date(), d = new Date(t.getFullYear(), t.getMonth(), t.getDate());
  return ptIso(d < PT_START ? PT_START : d > PT_END ? PT_END : d);
}
const ptId = () => Date.now().toString(36) + Math.random().toString(36).slice(2, 6);
const ptEsc = s => String(s).replace(/[&<>"']/g, c => ({'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'}[c]));
const ptByDate = (a, b) => a.date < b.date ? -1 : a.date > b.date ? 1 : 0;

// ---- number formatting ----
function ptFmt(v, dp){
  dp = dp == null ? 1 : dp;
  return (Math.round(v * Math.pow(10, dp)) / Math.pow(10, dp)).toLocaleString('en-GB', {maximumFractionDigits: dp});
}
function ptSigned(v, dp, suffix){
  const r = Math.round(Math.abs(v) * Math.pow(10, dp)) / Math.pow(10, dp);
  suffix = suffix || '';
  return r === 0 ? '0' + suffix : (v > 0 ? '+' : '−') + r.toLocaleString('en-GB', {minimumFractionDigits: dp, maximumFractionDigits: dp}) + suffix;
}
const ptChg = v => v > 0.05 ? 'chg-up' : v < -0.05 ? 'chg-down' : 'chg-flat';

// ---- exercises you can log ----
// e1rm     = weight x reps, tracked as estimated 1RM (Epley: weight x (1 + reps/30))
// load     = weight x reps, tracked as the load lifted (loaded jumps)
// distance = one number in cm (jump distance or height)
const PT_EXERCISES = [
  {key: 'box-squat',           name: 'Box Squat',            cat: 'strength', mode: 'e1rm'},
  {key: 'bench-press',         name: 'Bench Press',          cat: 'strength', mode: 'e1rm'},
