  document.getElementById('ch-alerts-list').innerHTML = alerts.length ? alerts.slice(0, 5).map(a => `<div class="ch-alert">
    <div class="ch-alert-tag ${a.tag}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">${a.circle ? '<circle cx="12" cy="12" r="9"/>' : ''}<path d="${a.path}"/></svg>${a.label}</div>
    <div class="ch-alert-desc">${a.desc}</div>
  </div>`).join('') : `<div class="ch-alert"><div class="ch-alert-tag positive"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>All Clear</div><div class="ch-alert-desc">No alerts right now — everything's on track.</div></div>`;

  // this week's sessions list (right rail)
  document.getElementById('ch-sessions-list').innerHTML = wc.days.length ? wc.days.map(k => {
    const done = !!completed[`${wk.wk}-${k}`];
    const first = (wk[k] || '').split('\n')[0] || '—';
    return `<div class="ch-sess-row" style="cursor:pointer;" data-goview="weekly"><span class="dot" style="background:${done ? 'var(--mint)' : 'var(--line2)'};"></span><div><div class="ch-sess-title">${dayNames[k]}${done ? ' ✓' : ''}</div><div class="ch-sess-time">${first}</div></div></div>`;
  }).join('') : '<div style="color:var(--muted2);font-size:12px;">No sessions prescribed this week.</div>';
  document.getElementById('ch-sessions-list').querySelectorAll('[data-goview]').forEach(el => el.onclick = () => goToView(el.dataset.goview));
}
document.getElementById('ch-qa-today').onclick = () => goToView('weekly');
document.getElementById('ch-qa-progress').onclick = () => goToView('progress');
document.getElementById('ch-qa-testing').onclick = () => goToView('testing');
