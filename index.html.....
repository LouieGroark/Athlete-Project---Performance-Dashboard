// ---- trend charts ----
let ptGradSeq = 0;
function ptNiceScale(min, max, target){
  if(!(max > min)){ const p = Math.abs(max) * 0.05 || 1; min -= p; max += p; }
  const rough = (max - min) / target, pow = Math.pow(10, Math.floor(Math.log10(rough))), f = rough / pow;
  const step = (f <= 1 ? 1 : f <= 2 ? 2 : f <= 5 ? 5 : 10) * pow;
  const lo = Math.floor(min / step + 1e-9) * step, hi = Math.ceil(max / step - 1e-9) * step, ticks = [];
  for(let v = lo; v <= hi + step * 0.001; v += step) ticks.push(Math.round(v * 1e6) / 1e6);
  return {lo, hi, ticks};
}
const ptAxis = v => Math.abs(v) >= 10000 ? (+(v / 1000).toFixed(1)) + 'k' : ptFmt(v, 1);
function ptChartSvg(points, o){
  const W = o.wide ? 600 : 400, H = 230, padL = 48, padR = 18, padT = 24, padB = 30;
  const plotW = W - padL - padR, plotH = H - padT - padB, n = points.length;
  const vals = points.filter(p => p.value != null).map(p => p.value);
  let lo = Math.min(...vals), hi = Math.max(...vals);
  if(o.kind === 'bar'){ lo = 0; hi = hi * 1.08; }
  else { const pad = (hi - lo) ? (hi - lo) * 0.18 : (Math.abs(hi) * 0.06 || 1); lo -= pad; hi += pad; }
  const sc = ptNiceScale(lo, hi, 4);
  const y = v => padT + plotH - ((v - sc.lo) / (sc.hi - sc.lo)) * plotH;
  const slot = plotW / n;
  const x = i => o.kind === 'bar' ? padL + slot * (i + 0.5) : (n === 1 ? padL + plotW / 2 : padL + (i / (n - 1)) * plotW);
  const grid = sc.ticks.map(t => `<line x1="${padL}" y1="${y(t).toFixed(1)}" x2="${W - padR}" y2="${y(t).toFixed(1)}" stroke="var(--line)" stroke-width="1"/>` +
    `<text x="${padL - 8}" y="${(y(t) + 3.5).toFixed(1)}" text-anchor="end" font-size="10.5" fill="var(--muted2)">${ptAxis(t)}</text>`).join('');
  const every = Math.ceil(n / (o.wide ? 12 : 8));
  const xl = points.map((p, i) => (n - 1 - i) % every ? '' :
    `<text x="${x(i).toFixed(1)}" y="${H - 8}" text-anchor="middle" font-size="10.5" fill="var(--muted2)">${n <= 9 ? 'Wk ' : ''}${p.wk}</text>`).join('');
  const live = points.map((p, i) => p.value == null ? null : {x: x(i), y: y(p.value), p}).filter(Boolean);
  const last = live[live.length - 1];
  const lbl = `<text x="${last.x.toFixed(1)}" y="${(last.y - 9).toFixed(1)}" text-anchor="${last.x > W - padR - 28 ? 'end' : 'middle'}" font-size="11.5" font-weight="700" fill="${o.color}">${ptFmt(last.p.value, o.dp)}</text>`;
  let body;
  if(o.kind === 'bar'){
    const bw = Math.min(o.wide ? 54 : 40, slot * 0.62), base = y(sc.lo);
    body = live.map(q => `<rect x="${(q.x - bw / 2).toFixed(1)}" y="${q.y.toFixed(1)}" width="${bw.toFixed(1)}" height="${Math.max(1, base - q.y).toFixed(1)}" rx="3" fill="${o.color}" opacity="${q === last ? 1 : 0.55}"><title>Wk ${q.p.wk} · ${ptFmt(q.p.value, o.dp)} ${o.unit}</title></rect>`).join('') + lbl;
  } else {
    const d = live.map((q, i) => (i ? 'L' : 'M') + q.x.toFixed(1) + ' ' + q.y.toFixed(1)).join(' ');
    const gid = 'ptg' + (++ptGradSeq), base = y(sc.lo).toFixed(1);
    const area = live.length > 1 ? `<path d="${d} L ${last.x.toFixed(1)} ${base} L ${live[0].x.toFixed(1)} ${base} Z" fill="url(#${gid})"/>` : '';
    body = `<defs><linearGradient id="${gid}" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="${o.color}" stop-opacity="0.32"/><stop offset="100%" stop-color="${o.color}" stop-opacity="0"/></linearGradient></defs>${area}` +
      (live.length > 1 ? `<path d="${d}" fill="none" stroke="${o.color}" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>` : '') +
      live.map(q => `<circle cx="${q.x.toFixed(1)}" cy="${q.y.toFixed(1)}" r="${q === last ? 4.2 : 3}" fill="${o.color}"><title>Wk ${q.p.wk} · ${ptFmt(q.p.value, o.dp)} ${o.unit}</title></circle>`).join('') + lbl;
  }
  return `<svg viewBox="0 0 ${W} ${H}" width="100%" style="display:block;" role="img" aria-label="${ptEsc(o.title)} chart">${grid}${xl}${body}</svg>`;
}
function ptTrendCard(o){
  const valid = o.pts.filter(p => p.value != null);
  let inner;
  if(!valid.length){
    inner = `<div class="tc-empty"><span>${o.empty}</span><button class="btn btn-sm" data-log="${o.logType}"${o.logKey ? ` data-key="${o.logKey}"` : ''}>${o.logLabel}</button></div>`;
  } else {
    const first = valid[0], last = valid[valid.length - 1];
    let delta = '', note;
    if(valid.length > 1){
      const d = last.value - first.value, pct = first.value ? d / first.value * 100 : 0;
      const col = o.neutral ? 'var(--muted)' : (d > 0.0001 ? 'var(--mint)' : d < -0.0001 ? 'var(--red)' : 'var(--muted2)');
      delta = `<span class="tc-delta" style="color:${col};">${d > 0.0001 ? '▲' : d < -0.0001 ? '▼' : '■'} ${ptSigned(d, o.dp, ' ' + o.unit)} (${ptSigned(pct, 1, '%')})</span>`;
      note = `Change since Wk ${first.wk} · ${o.note}`;
    } else note = `One week logged so far · ${o.note}`;
    inner = `<div><span class="tc-val" style="color:${o.color};">${ptFmt(last.value, o.dp)} ${o.unit}</span>${delta}</div>
      <div class="tc-note">${note}</div>
      <div class="tc-chart">${ptChartSvg(o.pts, o)}</div>`;
  }
  return `<div class="card trend-card${o.cardWide ? ' wide' : ''}"><div class="tc-title">${o.title}</div>${inner}</div>`;
}
// cycle of colours for however many lift charts end up being generated
const PT_CHART_COLORS = ['var(--blue)','var(--amber)','var(--violet)','var(--mint)','var(--red)','var(--slate)'];
function renderProgressCharts(weeks){
  const wrap = document.getElementById('progress-charts'), vw = window.innerWidth;
  const est = 'best estimated 1RM each week';

  // Back Squat, Power Clean and Bench Press are always charted (they show a prompt until something is logged).
  // Weights typed next to these lifts on Weekly Sessions feed straight in; Power Clean also picks up the
  // Hang Power Clean the weekly plan prescribes. Any other lift you log gets its own chart after these.
  const CORE = [
    {keys: ['back-squat'],                      key: 'back-squat',  name: 'Back Squat',  color: 'var(--blue)'},
    {keys: ['power-clean', 'hang-power-clean'], key: 'power-clean', name: 'Power Clean', color: 'var(--amber)', extra: ' (Power + Hang Power Clean)'},
    {keys: ['bench-press'],                     key: 'bench-press', name: 'Bench Press', color: 'var(--violet)'}
  ];
  const coreKeys = CORE.flatMap(c => c.keys);
  const coreSpecs = CORE.map(c => ({
    title: `1RM Trend - ${c.name}`, color: c.color, kind: 'line', unit: 'kg', dp: 1,
    pts: ptLiftSeries(c.keys, weeks), note: est + (c.extra || ''),
    empty: `No ${c.name} logged in this window yet — enter a weight next to it on Weekly Sessions, or log one here.`,
    logType: 'strength', logKey: c.key, logLabel: `Log a ${c.name}`
  }));
  coreSpecs[1].logType = 'power';

  const otherKeys = [...new Set(liftLog.map(e => e.exKey))].filter(k => !coreKeys.includes(k)).sort((a, b) => ptExOrder(a) - ptExOrder(b));
  const otherSpecs = otherKeys.map((key, i) => {
    const ex = PT_EXERCISES.find(x => x.key === key);
    if(!ex) return null;
    const unit = ptUnit(ex), dp = unit === 'cm' ? 0 : 1;
    const kindLabel = ex.mode === 'distance' ? 'Distance Trend' : ex.mode === 'load' ? 'Load Trend' : '1RM Trend';
    const noteText = ex.mode === 'distance' ? 'best distance each week' : ex.mode === 'load' ? 'best load lifted each week' : est;
    return {
      title: `${kindLabel} - ${ex.name}`, color: PT_CHART_COLORS[(i + CORE.length) % PT_CHART_COLORS.length],
      kind: 'line', unit, dp, pts: ptLiftSeries(key, weeks), note: noteText,
      empty: `No ${ex.name} logged in this window yet.`, logType: ex.cat, logKey: key, logLabel: `Log a ${ex.name}`
    };
  }).filter(Boolean);
  const liftSpecs = [...coreSpecs, ...otherSpecs];

  const specs = [
    ...liftSpecs,
    {title: 'Body Weight', color: 'var(--violet)', kind: 'line', unit: 'kg', dp: 1, pts: ptBwSeries(weeks),     note: 'last weigh-in each week', neutral: true, empty: 'No weigh-ins in this window yet.', logType: 'bodyweight', logLabel: 'Log a weigh-in'},
    {title: 'Total Volume', color: 'var(--mint)',  kind: 'bar',  unit: 'kg', dp: 0, pts: ptVolumeSeries(weeks), note: 'sets × reps × weight, all logged lifts', empty: 'No lifts logged in this window yet.', logType: 'strength', logLabel: 'Log a lift'}
  ];
  // the trailing Body Weight + Total Volume cards go wide; everything else is a standard 2-col card
  specs.forEach((s, i) => {
    const fromEnd = specs.length - 1 - i;
    const isTrailing = fromEnd < 2;
    s.cardWide = vw > 1100 && isTrailing;
    s.wide = vw > 1100 ? isTrailing : (vw > 640 && fromEnd === 0);
  });
  wrap.innerHTML = specs.length ? specs.map(ptTrendCard).join('') :
    `<div class="card trend-card" style="grid-column:1 / -1;"><div class="tc-title">Lift Trends</div>
      <div class="tc-empty"><span>No lifts logged yet — enter a weight next to any exercise on Weekly Sessions, or log one here.</span>
      <button class="btn btn-sm" data-log="strength">Log a lift</button></div></div>`;
  wrap.querySelectorAll('[data-log]').forEach(b => b.onclick = () => ptOpenModal(b.dataset.log, b.dataset.key));
}
