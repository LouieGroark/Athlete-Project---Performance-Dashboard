// ---------- date helpers ----------
function parseDate(str){
  // formats like "20 Apr 2026" or "Sat 05 Sep 2026"
  if(!str) return null;
  const m = str.match(/(\d{1,2})\s+(\w{3})\s+(\d{4})/);
  if(!m) return null;
  const months = {Jan:0,Feb:1,Mar:2,Apr:3,May:4,Jun:5,Jul:6,Aug:7,Sep:8,Oct:9,Nov:10,Dec:11};
  return new Date(m[3], months[m[2]], m[1]);
}
// "Today" follows the real clock, so the current week, sessions, next fixture and results all move on their own.
function startOfToday(){ const n = new Date(); return new Date(n.getFullYear(), n.getMonth(), n.getDate()); }
let TODAY = startOfToday();
// if the page is left open past midnight, reload so everything re-keys to the new date (all logged data is saved already)
document.addEventListener('visibilitychange', ()=>{ if(document.visibilityState==='visible' && startOfToday().getTime()!==TODAY.getTime()) location.reload(); });
setInterval(()=>{ if(startOfToday().getTime()!==TODAY.getTime()) location.reload(); }, 30*60*1000);

// ---------- fixtures / results / league table feed (National League 2 North, Billingham) ----------
// The results/league-table feed is specific to Billingham RFC's real
// fixtures — only show it to users who actually play for that club, since
// it isn't relevant (and would be misleading) for anyone else.
const LIVE = (clubName && clubName.trim().toLowerCase().includes('billingham'))
  ? (()=>{ try{ return JSON.parse(document.getElementById('live-feed').textContent); }catch(e){ return null; } })()
  : null;
function isoToDate(s){ const p = s.split('-').map(Number); return new Date(p[0], p[1]-1, p[2]); }
function applyLiveFeed(){
  if(!LIVE || !LIVE.results) return;
  LIVE.results.forEach(r=>{
    const rd = isoToDate(r.date).getTime();
    const f = DATA.fixtures.find(x=>{ const d = parseDate(x.date); return d && d.getTime()===rd && x.opp===r.opp; });
    if(!f) return;
    const tag = r.for > r.against ? 'W' : r.for < r.against ? 'L' : 'D';
    f.result = `${tag} ${r.for}-${r.against}`;
  });
}
applyLiveFeed();
// played = has a result · pending = date has passed but no result in the feed yet · today · upcoming
function fxStatus(f){
  if(f.result) return 'played';
  const d = parseDate(f.date);
  if(d && d < TODAY) return 'pending';
  if(d && d.getTime()===TODAY.getTime()) return 'today';
  return 'upcoming';
}
function findNextFixture(){ return DATA.fixtures.find(f=>{ const s = fxStatus(f); return s==='today' || s==='upcoming'; }); }
function ordinal(n){ const v = n%100; return n + ((v>=11&&v<=13) ? 'th' : ({1:'st',2:'nd',3:'rd'}[n%10] || 'th')); }
function getLeagueRows(){
  if(!LIVE || !LIVE.table) return [];
  const rows = LIVE.table.map(t=>({...t, pd: t.pf-t.pa, pts: 4*t.w + 2*t.d + t.tb + t.lb}));
  rows.sort((a,b)=> b.pts-a.pts || b.w-a.w || b.pd-a.pd || b.pf-a.pf);
  rows.forEach((r,i)=>{ r.pos = i+1; });
  return rows;
}

// find current week: the week whose W/C date <= today, and next week's date > today
function findCurrentWeek(){
  let best = DATA.weeks[0];
  for(const w of DATA.weeks){
    const d = parseDate(w.date);
    if(d && d <= TODAY) best = w; else break;
  }
  return best;
}
