        4-Day Gym Template
      </div>
      <div class="navitem" data-view="templates">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h10"/></svg>
        S&C Session Library
      </div>
      <div class="navitem" data-view="exercises">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
        Exercise Bank
      </div>
      <div class="navitem" data-view="testing">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 21V9m7 12V3m7 18v-7"/></svg>
        Testing & Monitoring
      </div>
      <div class="navitem" data-view="nutrition">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22c4-3 7-6.5 7-11a7 7 0 0 0-14 0c0 4.5 3 8 7 11Z"/><path d="M12 13c1.5-1.5 1.5-3 .5-4.5C11 7 12 5 12 5s-3 1-3 4c0 1.7.8 2.8 1.7 3.6"/></svg>
        Nutrition & Recovery
      </div>
      <div class="navitem" data-view="coaching">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/><path d="M17 3.5c1 .3 2 1.3 2 3s-1 2.7-2 3"/></svg>
        Coaching Hub
      </div>
    </div>
    <div class="sidebar-foot">Sourced from Billingham RFC's 2026/27 periodisation workbook. National League 2 North.</div>
  </nav>

  <div class="topbar-right">
    <button class="theme-toggle" id="themeToggle" type="button" title="Switch theme">
      <svg id="themeIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"></svg>
      <span class="tt-label" id="themeLabel">Dark</span>
    </button>
    <div class="identity-chip" id="identityChip" title="Click to sign out" style="cursor:pointer;">
      <div class="who" style="text-align:right;"><b id="identityName">Athlete Project</b><span id="identitySub">Performance Dashboard</span></div>
      <div class="avatar"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4.4 3.6-7 8-7s8 2.6 8 7"/></svg></div>
    </div>
  </div>

  <main>
    <!-- ============ OVERVIEW ============ -->
    <section class="view active" id="view-overview">
      <div class="pagehead">
        <div>
          <h2>Season Overview</h2>
          <p id="ov-sub">Your training year at a glance — phase, fixtures and this week's work.</p>
        </div>
        <span class="pill">Today · <b id="ov-today"></b></span>
      </div>

      <div class="grid g2" style="margin-bottom:16px;align-items:stretch;">
        <div class="card">
          <h3>This Week's Training</h3>
          <div class="session-feature">
            <div class="session-thumb">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M2 12h2M20 12h2M5 8v8M19 8v8M5 12h1M18 12h1M8 6v12M16 6v12M8 12h8"/></svg>
            </div>
            <div>
              <div class="session-title">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M8 12l3 3 5-6"/></svg>
                <span id="ov-feat-title">—</span>
              </div>
              <div class="session-meta" id="ov-feat-sub">—</div>
              <div class="chip-row" id="ov-feat-chips"></div>
            </div>
          </div>
          <button class="btn btn-primary btn-full" onclick="goToWeekView(currentWeekNum)">Open full week →</button>
        </div>
        <div class="card">
          <h3>Season Progress</h3>
          <div class="ring-wrap">
            <svg width="118" height="118" viewBox="0 0 118 118">
              <circle cx="59" cy="59" r="50" fill="none" stroke="var(--line)" stroke-width="11"/>
              <circle id="ov-ring-circle" cx="59" cy="59" r="50" fill="none" stroke="var(--mint)" stroke-width="11" stroke-linecap="round" transform="rotate(-90 59 59)"/>
              <text x="59" y="54" text-anchor="middle" class="ring-center" fill="var(--text)" font-size="16" id="ov-ring-week">—</text>
              <text x="59" y="72" text-anchor="middle" fill="var(--muted2)" font-size="10.5" id="ov-ring-sub">—</text>
            </svg>
            <div class="ring-info">
              <div class="ri-row"><div class="l">Current phase</div><div class="v" id="ov-ring-phase">—</div></div>
              <div class="ri-row"><div class="l">Position in phase</div><div class="v" id="ov-ring-pos">—</div></div>
              <div class="ri-row"><div class="l">Next up</div><div class="v" id="ov-ring-next">—</div></div>
            </div>
          </div>
        </div>
      </div>

      <div class="grid g4" style="margin-bottom:16px;">
        <div class="stat-card">
          <div class="stat-icon ic-mint"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19h16M6 15l4-6 3 4 5-9"/></svg></div>
          <h3>Current Phase</h3>
          <div class="stat-num" id="ov-phase" style="font-size:19px;">—</div>
          <div class="stat-sub" id="ov-phase-range">—</div>
          <div class="accent-bar bar-mint"></div>
        </div>
        <div class="stat-card">
          <div class="stat-icon ic-blue"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 10h18M8 2v4M16 2v4"/></svg></div>
          <h3>Current Week</h3>
          <div class="stat-num" id="ov-week">—</div>
          <div class="stat-sub" id="ov-week-tier">—</div>
          <div class="accent-bar bar-blue"></div>
        </div>
        <div class="stat-card">
          <div class="stat-icon ic-amber"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M8 2v4M16 2v4M3 9h18"/></svg></div>
          <h3>Next Fixture</h3>
          <div class="stat-num" id="ov-fixture" style="font-size:17px;">—</div>
          <div class="stat-sub" id="ov-fixture-sub">—</div>
          <div class="accent-bar bar-amber"></div>
        </div>
        <div class="stat-card">
          <div class="stat-icon ic-violet"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M8 12l3 3 5-6"/></svg></div>
          <h3>Sessions Logged</h3>
          <div class="stat-num" id="ov-logged">0</div>
          <div class="stat-sub">of 284 across the season</div>
          <div class="accent-bar bar-violet"></div>
        </div>
      </div>

      <div class="card" style="margin-bottom:16px;">
        <h3>21-Phase Macrocycle — click a phase to jump into it</h3>
        <div class="timeline" id="ov-timeline"></div>
      </div>

      <div class="grid g2">
        <div class="card">
          <h3>This Week's Split</h3>
          <div id="ov-thisweek"></div>
        </div>
        <div class="card">
          <h3>Upcoming Fixtures</h3>
          <div id="ov-upcoming"></div>
        </div>
      </div>

      <div class="card" style="margin-top:16px;" id="ov-sesslog-card">
        <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:14px;flex-wrap:wrap;">
          <h3 style="margin:0;">Session Log</h3>
          <span class="pill" id="ov-sesslog-count">0 sessions</span>
        </div>
        <div id="ov-sesslog"></div>
      </div>

      <div class="insight-box" style="margin-top:16px;" id="ov-insight">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 21V9m7 12V3m7 18v-7"/></svg>
        <div></div>
      </div>
    </section>

    <!-- ============ FIXTURES ============ -->
    <section class="view" id="view-fixtures">
      <div class="pagehead">
        <div><h2>2026/27 Fixtures</h2><p>All 26 National League 2 North fixtures — home and away against every other club in the division.</p></div>
        <span class="pill" id="fx-record">—</span>
      </div>
      <div class="feed-note" id="fx-feed-note"></div>
      <div class="card" id="fx-scan-card" style="padding:14px 16px;margin-bottom:14px;">
        <div style="font-weight:700;font-size:13px;margin-bottom:4px;">Scan a club website for fixtures</div>
        <div style="font-size:11.5px;color:var(--muted2);margin-bottom:10px;">Pulls the full season's fixture list and keeps first-team matches only — other teams (2nds, colts, ladies, etc.) are filtered out.</div>
        <div style="display:flex;gap:10px;flex-wrap:wrap;">
          <div style="flex:1;min-width:160px;">
            <label style="display:block;font-size:11px;color:var(--muted2);margin-bottom:4px;">Your team</label>
            <input id="fx-my-team" type="text" list="fx-team-list" placeholder="e.g. Billingham" style="width:100%;">
            <datalist id="fx-team-list"></datalist>
          </div>
          <div style="flex:1;min-width:160px;">
            <label style="display:block;font-size:11px;color:var(--muted2);margin-bottom:4px;">First-team keyword (optional)</label>
