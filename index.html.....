// ==================== OVERVIEW ====================
function phaseWeekRange(p){
  const m = p.weeks.match(/Wk\s*(\d+)(?:-(\d+))?/);
  if(!m) return [null,null];
  return [+m[1], m[2]?+m[2]:+m[1]];
}
function findPhaseForWeek(weekNum){
  return DATA.phases.find(p=>{ const [s,e]=phaseWeekRange(p); return s!=null && weekNum>=s && weekNum<=e; });
}
function findNextPhase(weekNum){
  return DATA.phases.filter(p=>{ const [s]=phaseWeekRange(p); return s!=null && s>weekNum; })
    .sort((a,b)=>phaseWeekRange(a)[0]-phaseWeekRange(b)[0])[0];
}
