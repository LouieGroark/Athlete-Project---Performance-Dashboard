    saveLocal('brfc_coach_notes', chCoachNotes);
    document.getElementById('ch-note-sub').textContent = `Latest: "${note.trim()}"`;
  }
};
if(chCoachNotes.length) document.getElementById('ch-note-sub').textContent = `Latest: "${chCoachNotes[chCoachNotes.length - 1].text}"`;

// ==================== INIT ====================
renderOverview();
renderFixtures('all');
renderFeedNote();
renderPhaseCards();
renderTierAndBlockTables();
renderMesocycleChart();
populateWeekSelect();
setWeek(currentWeekNum);
renderProgress();
renderFourDayTabs();
renderFourDayTable();
