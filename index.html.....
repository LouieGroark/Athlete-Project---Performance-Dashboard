<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Athlete Project — Performance Dashboard</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
:root{
  --bg:#0a0e17;
  --bg2:#0c1220;
  --panel:#111726;
  --panel2:#161d2e;
  --line:#212a3d;
  --line2:#2e3a52;
  --text:#f2f5f9;
  --muted:#96a2b8;
  --muted2:#69748c;
  --mint:#3ee79b;
  --mint-soft:rgba(62,231,155,.14);
  --mint-dim:#1c6b4c;
  --amber:#f6b94d;
  --amber-soft:rgba(246,185,77,.14);
  --red:#f37272;
  --red-soft:rgba(243,114,114,.14);
  --blue:#5b9cf6;
  --blue-soft:rgba(91,156,246,.14);
  --violet:#b083f0;
  --violet-soft:rgba(176,131,240,.14);
  --slate:#7c89a6;
  --slate-soft:rgba(124,137,166,.14);
  --radius:4px;
  --radius-sm:3px;
}
@media (prefers-color-scheme: light){
  :root:not([data-theme]){
    --bg:#f3f5f8; --bg2:#eaedf3; --panel:#ffffff; --panel2:#f3f5f9;
    --line:#dde2ea; --line2:#c7cede; --text:#141a24; --muted:#5b6576; --muted2:#8892a3;
    --mint-soft:rgba(28,160,105,.12); --amber-soft:rgba(180,120,10,.12);
    --red-soft:rgba(200,60,60,.1); --blue-soft:rgba(40,100,200,.1); --violet-soft:rgba(140,80,200,.1);
    --mint:#1ca069; --amber:#b4780a; --red:#c83c3c; --blue:#2864c8; --violet:#8c50c8;
    --slate:#5b6576; --slate-soft:rgba(91,101,118,.1);
  }
}
:root[data-theme="dark"]{
  --bg:#0a0e17; --bg2:#0c1220; --panel:#111726; --panel2:#161d2e;
  --line:#212a3d; --line2:#2e3a52; --text:#f2f5f9; --muted:#96a2b8; --muted2:#69748c;
  --mint:#3ee79b; --mint-soft:rgba(62,231,155,.14); --mint-dim:#1c6b4c;
  --amber:#f6b94d; --amber-soft:rgba(246,185,77,.14);
  --gold:#d9a441; --gold-soft:rgba(217,164,65,.16);
  --red:#f37272; --red-soft:rgba(243,114,114,.14);
  --blue:#5b9cf6; --blue-soft:rgba(91,156,246,.14);
  --violet:#b083f0; --violet-soft:rgba(176,131,240,.14);
  --slate:#7c89a6; --slate-soft:rgba(124,137,166,.14);
}
:root[data-theme="light"]{
  --bg:#f3f5f8; --bg2:#eaedf3; --panel:#ffffff; --panel2:#f3f5f9;
  --line:#dde2ea; --line2:#c7cede; --text:#141a24; --muted:#5b6576; --muted2:#8892a3;
  --mint-soft:rgba(28,160,105,.12); --amber-soft:rgba(180,120,10,.12);
  --gold:#9a6d0f; --gold-soft:rgba(154,109,15,.12);
  --red-soft:rgba(200,60,60,.1); --blue-soft:rgba(40,100,200,.1); --violet-soft:rgba(140,80,200,.1);
  --mint:#1ca069; --amber:#b4780a; --red:#c83c3c; --blue:#2864c8; --violet:#8c50c8;
  --slate:#5b6576; --slate-soft:rgba(91,101,118,.1);
}
:root[data-theme="alt"]{
  --bg:#12111a; --bg2:#161522; --panel:#1c1a29; --panel2:#242233;
  --line:#332f47; --line2:#453f5e; --text:#f1eefc; --muted:#a8a2c4; --muted2:#756e94;
  --mint:#b98cf0; --mint-soft:rgba(185,140,240,.16); --mint-dim:#5c3d8f;
  --amber:#f0a860; --amber-soft:rgba(240,168,96,.16);
  --gold:#e0b854; --gold-soft:rgba(224,184,84,.16);
  --red:#f0708a; --red-soft:rgba(240,112,138,.14);
  --blue:#6fa8f0; --blue-soft:rgba(111,168,240,.14);
  --violet:#f0a860; --violet-soft:rgba(240,168,96,.16);
  --slate:#8a83ab; --slate-soft:rgba(138,131,171,.14);
}
*{box-sizing:border-box;}
html,body{margin:0;padding:0;background:var(--bg);color:var(--text);font-family:'Inter',sans-serif;}
body{display:flex;min-height:100vh;background:var(--bg);}
::-webkit-scrollbar{width:8px;height:8px;}
::-webkit-scrollbar-thumb{background:var(--line2);border-radius:6px;}

h1,h2,h3,h4,.disp{font-family:'Inter',sans-serif;font-weight:700;letter-spacing:-.01em;margin:0;color:var(--text);}
.wordmark{font-weight:800;letter-spacing:.06em;text-transform:uppercase;}

/* ---- layout ---- */
#app{display:flex;width:100%;min-height:100vh;}
.sidebar{
  width:236px;flex-shrink:0;background:var(--bg2);border-right:1px solid var(--line);
  display:flex;flex-direction:column;padding:22px 14px;position:sticky;top:0;height:100vh;overflow-y:auto;
}
.brand{display:flex;align-items:center;gap:11px;padding:0 8px 20px 8px;border-bottom:1px solid var(--line);margin-bottom:16px;}
.brand img{width:100%;height:auto;max-height:64px;object-fit:contain;}
.crest{width:38px;height:38px;border-radius:3px;background:linear-gradient(155deg,var(--mint),#1c6b4c);display:flex;align-items:center;justify-content:center;font-family:'Inter';font-weight:800;font-size:15px;color:#06251a;flex-shrink:0;}
.brand-name{font-family:'Inter';font-weight:800;font-size:14.5px;line-height:1.2;letter-spacing:.03em;text-transform:uppercase;}
.brand-sub{font-size:10px;color:var(--muted2);letter-spacing:.05em;margin-top:2px;}

.nav-group{margin-bottom:4px;}
.nav-label{font-size:10px;color:var(--muted2);padding:14px 10px 6px;letter-spacing:.08em;}
.navitem{
  display:flex;align-items:center;gap:11px;padding:10px 12px;border-radius:3px;color:var(--muted);
  cursor:pointer;font-size:13.5px;font-weight:500;transition:background .12s,color .12s;user-select:none;
}
.navitem:hover{background:var(--panel2);color:var(--text);}
.navitem.active{background:var(--mint);color:#06251a;font-weight:600;}
.navitem svg{width:17px;height:17px;flex-shrink:0;opacity:.9;}
.nav-badge{margin-left:auto;background:var(--red);color:#fff;font-size:10.5px;font-weight:700;border-radius:100px;min-width:17px;height:17px;display:flex;align-items:center;justify-content:center;padding:0 5px;}
.navitem.active .nav-badge{background:#06251a;color:var(--mint);}
.sidebar-foot{margin-top:auto;padding-top:14px;border-top:1px solid var(--line);font-size:10px;color:var(--muted2);letter-spacing:.03em;}

main{flex:1;min-width:0;padding:26px 32px 60px;position:relative;}

/* persistent identity chip + theme toggle, top-right of every page */
.topbar-right{position:fixed;top:20px;right:30px;z-index:40;display:flex;align-items:center;gap:10px;}
.theme-toggle{
  display:flex;align-items:center;gap:7px;background:var(--panel);border:1px solid var(--line);
  border-radius:100px;padding:6px 13px;font-family:'Inter';font-size:12px;font-weight:600;color:var(--muted);
  cursor:pointer;transition:border-color .12s,color .12s;user-select:none;
}
.theme-toggle:hover{border-color:var(--mint);color:var(--mint);}
.theme-toggle svg{width:15px;height:15px;flex-shrink:0;}
@media(max-width:900px){.theme-toggle span.tt-label{display:none;}}
.identity-chip{
  display:flex;align-items:center;gap:9px;
  background:var(--panel);border:1px solid var(--line);border-radius:100px;padding:6px 14px 6px 6px;
}
.identity-chip .avatar{width:28px;height:28px;border-radius:50%;background:var(--panel2);border:1px solid var(--line2);display:flex;align-items:center;justify-content:center;color:var(--muted);flex-shrink:0;}
.identity-chip .avatar svg{width:15px;height:15px;}
.identity-chip .who{line-height:1.15;}
.identity-chip .who b{display:block;font-size:12.5px;font-weight:700;color:var(--text);}
.identity-chip .who span{font-size:10.5px;color:var(--muted2);}
@media(max-width:900px){.identity-chip{display:none;}.topbar-right{gap:0;}}

/* ---------- auth gate ---------- */
.auth-gate{position:fixed;inset:0;z-index:100;display:flex;align-items:center;justify-content:center;background:var(--bg);}
.auth-card{width:100%;max-width:360px;padding:32px 28px;background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);}
.auth-brand{font-size:18px;font-weight:800;color:var(--text);letter-spacing:-.01em;}
.auth-sub{font-size:13px;color:var(--muted);margin-top:4px;margin-bottom:22px;}
.auth-label{display:block;font-size:11.5px;color:var(--muted);margin:14px 0 6px;}
.auth-input{width:100%;box-sizing:border-box;padding:9px 11px;background:var(--panel2);border:1px solid var(--line2);border-radius:var(--radius-sm);color:var(--text);font-size:13.5px;font-family:inherit;}
.auth-input:focus{outline:none;border-color:var(--mint);}
.auth-btn{width:100%;margin-top:20px;padding:10px;background:var(--mint);border:none;border-radius:var(--radius-sm);color:#08130d;font-weight:700;font-size:13.5px;cursor:pointer;}
.auth-btn:disabled{opacity:.6;cursor:default;}
.auth-link{display:block;width:100%;margin-top:12px;background:none;border:none;color:var(--muted);font-size:12px;text-align:center;cursor:pointer;text-decoration:underline;text-underline-offset:2px;}
.auth-error{background:var(--red-soft);color:var(--red);border-radius:var(--radius-sm);padding:8px 10px;font-size:12.5px;margin-bottom:6px;}

.pagehead{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;margin-bottom:22px;flex-wrap:wrap;padding-right:220px;}
@media(max-width:900px){.pagehead{padding-right:0;}}
.pagehead h2{font-size:26px;letter-spacing:-.02em;}
.pagehead p{margin:5px 0 0;color:var(--muted);font-size:13.5px;max-width:560px;}
.pill{display:inline-flex;align-items:center;gap:6px;background:var(--panel);border:1px solid var(--line);padding:6px 13px;border-radius:100px;font-size:12.5px;color:var(--muted);}
.pill b{color:var(--text);font-weight:600;}

.grid{display:grid;gap:16px;}
.g2{grid-template-columns:repeat(2,1fr);}
.g3{grid-template-columns:repeat(3,1fr);}
.g4{grid-template-columns:repeat(4,1fr);}
@media(max-width:1000px){.g3,.g4{grid-template-columns:repeat(2,1fr);}}
@media(max-width:640px){.g2,.g3,.g4{grid-template-columns:1fr;}}

.card{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:20px;}
.card h3{font-size:11.5px;font-weight:600;color:var(--muted2);text-transform:uppercase;letter-spacing:.06em;margin-bottom:14px;font-family:'Inter';}

/* ---- stat cards ---- */
.stat-card{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:18px;position:relative;overflow:hidden;}
.stat-card .stat-icon{width:32px;height:32px;border-radius:3px;display:flex;align-items:center;justify-content:center;margin-bottom:12px;}
.stat-card .stat-icon svg{width:16px;height:16px;}
.ic-mint{background:var(--mint-soft);color:var(--mint);}
.ic-amber{background:var(--amber-soft);color:var(--amber);}
.ic-gold{background:var(--gold-soft);color:var(--gold);}
.ic-blue{background:var(--blue-soft);color:var(--blue);}
.ic-red{background:var(--red-soft);color:var(--red);}
.ic-violet{background:var(--violet-soft);color:var(--violet);}
.stat-card h3{margin-bottom:8px;}
.stat-num{font-family:'Inter';font-size:28px;font-weight:700;line-height:1.1;letter-spacing:-.02em;}
.stat-sub{font-size:12px;color:var(--muted2);margin-top:7px;}
.delta{font-size:12px;font-weight:600;display:inline-flex;align-items:center;gap:3px;margin-top:7px;}
.delta-up{color:var(--mint);}
.delta-down{color:var(--red);}
.delta::before{font-size:9px;}
.delta-up::before{content:'▲';}
.delta-down::before{content:'▼';}
.accent-bar{position:absolute;left:0;bottom:0;width:100%;height:3px;}
.bar-mint{background:var(--mint);} .bar-amber{background:var(--amber);} .bar-gold{background:var(--gold);}
.bar-blue{background:var(--blue);} .bar-red{background:var(--red);} .bar-violet{background:var(--violet);}

/* mini lift cards */
.lift-card{background:var(--panel2);border:1px solid var(--line);border-radius:var(--radius-sm);padding:13px 14px;position:relative;overflow:hidden;}
.lift-card .lbl{font-size:11px;color:var(--muted2);margin-bottom:5px;}
.lift-card .val{font-family:'Inter';font-size:19px;font-weight:700;}

/* season progress ring */
.ring-wrap{display:flex;align-items:center;gap:22px;flex-wrap:wrap;}
.ring-center{font-family:'Inter';font-weight:700;}
.ring-info{display:flex;flex-direction:column;gap:10px;flex:1;min-width:160px;}
.ring-info .ri-row .l{font-size:10.5px;color:var(--muted2);text-transform:uppercase;letter-spacing:.05em;}
.ring-info .ri-row .v{font-size:14px;font-weight:600;color:var(--text);margin-top:1px;}

/* today session style card */
.session-feature{display:grid;grid-template-columns:150px 1fr;gap:18px;align-items:stretch;}
@media(max-width:700px){.session-feature{grid-template-columns:1fr;}}
.session-thumb{border-radius:var(--radius-sm);background:linear-gradient(155deg,#1a3628,#0d1e16);border:1px solid var(--line);display:flex;align-items:center;justify-content:center;color:var(--mint);min-height:100px;}
.session-thumb svg{width:34px;height:34px;opacity:.75;}
.session-title{display:flex;align-items:center;gap:8px;font-weight:700;font-size:16px;}
.session-title svg{width:18px;height:18px;color:var(--mint);flex-shrink:0;}
.session-meta{color:var(--muted);font-size:12.5px;margin-top:3px;}
.chip-row{display:flex;gap:6px;flex-wrap:wrap;margin-top:10px;}
.chip{background:var(--panel2);border:1px solid var(--line);border-radius:100px;padding:3px 11px;font-size:11.5px;color:var(--muted);}

/* nutrition page */
.meal-row{display:flex;align-items:flex-start;gap:12px;padding:13px 0;border-bottom:1px solid var(--line);}
.meal-row:last-child{border-bottom:none;}
.meal-icon{width:34px;height:34px;border-radius:3px;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px;}
.meal-icon svg{width:16px;height:16px;}
.meal-body{flex:1;min-width:0;}
.meal-title{font-weight:700;font-size:14px;color:var(--text);}
.meal-sub{color:var(--muted);font-size:12.5px;margin-top:2px;}
.meal-sub.empty{color:var(--muted2);font-style:italic;}
.meal-foods{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px;}
.food-chip{display:inline-flex;align-items:center;gap:7px;background:var(--panel2);border:1px solid var(--line);border-radius:100px;padding:4px 6px 4px 12px;font-size:11.5px;color:var(--text);}
.food-chip .fc-macros{color:var(--muted2);font-size:10.5px;}
.food-chip button{padding:0;width:16px;height:16px;min-width:16px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:12px;line-height:1;border:none;background:var(--line);color:var(--muted);}
.food-chip button:hover{background:var(--red);color:#fff;border-color:var(--red);}
.meal-add-btn{flex-shrink:0;width:30px;height:30px;border-radius:50%;padding:0;display:flex;align-items:center;justify-content:center;font-size:17px;line-height:1;margin-top:2px;}
.nu-search-wrap{position:relative;}
.nu-suggest{position:absolute;top:calc(100% + 4px);left:0;right:0;background:var(--panel);border:1px solid var(--line2);border-radius:3px;max-height:230px;overflow-y:auto;z-index:5;box-shadow:0 10px 28px rgba(0,0,0,.4);}
.nu-suggest .ns-item{padding:8px 11px;font-size:13px;cursor:pointer;display:flex;justify-content:space-between;align-items:baseline;gap:10px;}
.nu-suggest .ns-item:hover{background:var(--panel2);}
.nu-suggest .ns-item .ns-kcal{color:var(--muted2);font-size:11px;white-space:nowrap;flex-shrink:0;}
.nu-suggest .ns-empty{padding:9px 11px;font-size:12px;color:var(--muted2);}
.nu-selected-food{display:flex;align-items:center;justify-content:space-between;gap:8px;background:var(--mint-soft);border:1px solid var(--mint-dim);border-radius:3px;padding:7px 11px;font-size:12px;color:var(--text);margin-bottom:12px;}
.nu-selected-food button{background:none;border:none;color:var(--muted);cursor:pointer;font-size:15px;line-height:1;padding:0 0 0 8px;}
.nu-selected-food button:hover{color:var(--red);}
.nu-db-note{font-size:11px;color:var(--muted2);margin:-4px 0 12px;}
.supp-row{display:flex;align-items:center;gap:10px;padding:9px 0;border-bottom:1px solid var(--line);font-size:13.5px;}
.supp-row:last-child{border-bottom:none;}
.supp-check{width:20px;height:20px;border-radius:50%;border:1.5px solid var(--line2);flex-shrink:0;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:.12s;}
.supp-check.done{background:var(--mint);border-color:var(--mint);}
.supp-check.done::after{content:"✓";color:#06251a;font-size:11px;font-weight:800;}
.recovery-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;text-align:center;}
@media(max-width:640px){.recovery-grid{grid-template-columns:1fr;}}
.recovery-item svg{width:24px;height:24px;color:var(--blue);margin-bottom:8px;}
.recovery-item .rv-label{font-size:12px;color:var(--muted2);text-transform:uppercase;letter-spacing:.04em;}
.recovery-item .rv-val{font-size:14.5px;font-weight:600;color:var(--text);margin-top:2px;}

/* coaching hub */
.ch-wrap{display:grid;grid-template-columns:1fr 330px;gap:16px;align-items:start;}
@media(max-width:1150px){.ch-wrap{grid-template-columns:1fr;}}
.ch-main{display:flex;flex-direction:column;gap:16px;}
.ch-summary{display:flex;align-items:center;flex-wrap:wrap;gap:30px;}
.ch-summary-head{flex:1;min-width:200px;}
.ch-summary-head h3{font-size:18px;margin-bottom:3px;}
.ch-summary-head p{color:var(--muted);font-size:12.5px;}
.ch-summary-stat{display:flex;align-items:center;gap:10px;}
.ch-summary-stat svg{width:20px;height:20px;color:var(--mint);flex-shrink:0;}
.ch-summary-stat .l{font-size:10.5px;color:var(--muted2);text-transform:uppercase;letter-spacing:.05em;}
.ch-summary-stat .v{font-size:14px;font-weight:700;color:var(--text);margin-top:1px;}
.ch-ring-sm{position:relative;width:76px;height:76px;flex-shrink:0;}
.ch-ring-sm .chn{font-size:22px;font-weight:800;}
.ch-glance{display:flex;gap:12px;align-items:flex-start;margin-bottom:12px;}
.ch-avatar{width:56px;height:70px;border-radius:5px;background:linear-gradient(160deg,#1c2536,#0b0f18);border:1px solid var(--line2);display:flex;align-items:center;justify-content:center;font-size:22px;font-weight:800;color:var(--mint);flex-shrink:0;}
.ch-glance-name{font-weight:700;font-size:14.5px;color:var(--text);}
.ch-glance-meta{font-size:11.5px;color:var(--muted2);margin-top:2px;}
.ch-kv-row{display:flex;justify-content:space-between;gap:8px;font-size:12px;padding:7px 0;border-bottom:1px solid var(--line);color:var(--muted);}
.ch-kv-row:last-child{border-bottom:none;}
.ch-kv-row .v{color:var(--text);font-weight:600;text-align:right;}
.ch-obj-headline{font-size:14.5px;font-weight:600;line-height:1.45;color:var(--text);margin:8px 0 14px;}
.ch-obj-cols{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px;}
.ch-obj-cols .l{font-size:10px;color:var(--muted2);text-transform:uppercase;letter-spacing:.05em;margin-bottom:3px;}
.ch-obj-cols .v{font-size:13px;font-weight:600;color:var(--text);}
.ch-load-label{font-size:10px;color:var(--muted2);text-transform:uppercase;letter-spacing:.05em;margin-bottom:5px;}
.ch-load-val{font-size:13.5px;font-weight:600;color:var(--text);margin-bottom:8px;}
.ch-load-bar{display:flex;gap:3px;}
.ch-load-bar span{flex:1;height:7px;border-radius:2px;background:var(--line);}
.ch-load-bar span.on{background:var(--mint);}
.ch-item-row{display:flex;gap:10px;align-items:flex-start;padding:9px 0;border-bottom:1px solid var(--line);}
.ch-item-row:last-child{border-bottom:none;}
.ch-item-icon{width:28px;height:28px;border-radius:3px;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.ch-item-icon svg{width:14px;height:14px;}
.ch-item-title{font-size:13px;font-weight:600;color:var(--text);}
.ch-item-sub{font-size:11px;color:var(--muted2);margin-top:1px;}
.ch-readiness-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;}
@media(max-width:900px){.ch-readiness-grid{grid-template-columns:repeat(2,1fr);}}
.ch-metric{background:var(--panel2);border:1px solid var(--line);border-radius:3px;padding:10px 12px;}
.ch-metric .l{font-size:10.5px;color:var(--muted2);text-transform:uppercase;letter-spacing:.04em;}
.ch-metric .v{font-size:17px;font-weight:700;color:var(--text);margin:3px 0 2px;}
.ch-metric .s{font-size:11px;font-weight:600;margin-bottom:6px;}
.ch-metric .mbar{height:5px;border-radius:2px;background:var(--line);overflow:hidden;}
.ch-metric .mbar span{display:block;height:100%;}
.ch-acwr-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:4px;}
.ch-legend{display:flex;gap:14px;font-size:11px;color:var(--muted2);flex-wrap:wrap;}
.ch-legend span{display:inline-flex;align-items:center;gap:5px;}
.ch-legend i{width:9px;height:9px;border-radius:2px;display:inline-block;}
.ch-acwr-badge{background:var(--mint-soft);color:var(--mint);font-size:11px;font-weight:700;padding:3px 10px;border-radius:100px;}
.ch-cmp-row{display:flex;align-items:center;gap:8px;font-size:11.5px;margin-bottom:9px;}
.ch-cmp-label{width:98px;flex-shrink:0;color:var(--muted);}
.ch-cmp-bar{flex:1;height:6px;background:var(--line);border-radius:3px;overflow:hidden;}
.ch-cmp-fill{height:100%;background:var(--mint);border-radius:3px;}
.ch-cmp-val{width:36px;text-align:right;color:var(--muted2);font-size:11px;}
.ch-mini-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:14px;}
.ch-mini-stat{background:var(--panel2);border:1px solid var(--line);border-radius:3px;padding:8px 10px;text-align:center;}
.ch-mini-stat .l{font-size:9.5px;color:var(--muted2);text-transform:uppercase;letter-spacing:.03em;}
.ch-mini-stat .v{font-size:14.5px;font-weight:700;color:var(--text);margin:2px 0;}
.ch-mini-stat .d{font-size:10.5px;font-weight:600;}
.ch-trend-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;}
@media(max-width:900px){.ch-trend-grid{grid-template-columns:repeat(2,1fr);}}
.ch-trend-card .l{font-size:11.5px;color:var(--muted);}
.ch-trend-card .v{font-size:19px;font-weight:700;color:var(--text);margin:3px 0 2px;}
.ch-trend-card .d{font-size:11px;font-weight:600;margin-bottom:8px;}
.ch-trend-wks{display:flex;justify-content:space-between;font-size:9.5px;color:var(--muted2);margin-top:3px;}
.ch-obj-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;}
@media(max-width:900px){.ch-obj-grid{grid-template-columns:1fr;}}
.ch-obj-title{font-size:11px;color:var(--muted2);text-transform:uppercase;letter-spacing:.05em;margin-bottom:10px;}
.ch-obj-list{display:flex;flex-direction:column;gap:10px;}
.ch-obj-num{width:22px;height:22px;border-radius:50%;background:var(--mint-soft);color:var(--mint);font-size:11.5px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.ch-obj-list-item{display:flex;align-items:center;gap:10px;font-size:12.5px;color:var(--text);}
.ch-phase-box{background:var(--panel2);border:1px solid var(--line);border-radius:3px;padding:12px 14px;}
.ch-phase-box .ph-title{font-size:12px;color:var(--muted2);text-transform:uppercase;letter-spacing:.04em;}
.ch-phase-box .ph-name{font-size:14px;font-weight:700;color:var(--text);margin:2px 0 10px;}
.ch-phase-row{display:flex;align-items:center;gap:9px;font-size:12px;padding:5px 0;color:var(--muted);}
.ch-phase-row.now{color:var(--text);}
.ch-phase-row .dot{width:7px;height:7px;border-radius:50%;background:var(--line2);flex-shrink:0;}
.ch-phase-row.done .dot{background:var(--mint);}
.ch-phase-row.now .dot{background:var(--mint);box-shadow:0 0 0 3px var(--mint-soft);}
.ch-phase-pill{margin-left:auto;background:var(--mint);color:#06251a;font-size:10px;font-weight:700;padding:2px 9px;border-radius:100px;}
.ch-side-card{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:16px 18px;}
.ch-side-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;}
.ch-side-head h3{font-size:13px;text-transform:uppercase;letter-spacing:.04em;display:flex;align-items:center;gap:8px;}
.ch-side-head svg{width:15px;height:15px;color:var(--red);}
.ch-alert{padding:11px 0;border-bottom:1px solid var(--line);}
.ch-alert:last-child{border-bottom:none;}
.ch-alert-tag{font-size:10.5px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;display:flex;align-items:center;gap:6px;margin-bottom:4px;}
.ch-alert-tag svg{width:13px;height:13px;}
.ch-alert-tag.high{color:var(--red);} .ch-alert-tag.monitor{color:var(--amber);} .ch-alert-tag.positive{color:var(--mint);}
.ch-alert-desc{font-size:12px;color:var(--muted);line-height:1.4;}
.ch-alert-link{font-size:11.5px;color:var(--mint);font-weight:600;margin-top:5px;display:inline-block;cursor:pointer;}
.ch-qa-item{display:flex;gap:10px;align-items:center;padding:9px 0;border-bottom:1px solid var(--line);cursor:pointer;}
.ch-qa-item:last-child{border-bottom:none;}
.ch-qa-item:hover .ch-item-title{color:var(--mint);}
.ch-qa-icon{width:30px;height:30px;border-radius:50%;background:var(--panel2);border:1px solid var(--line);display:flex;align-items:center;justify-content:center;flex-shrink:0;color:var(--muted);}
.ch-qa-icon svg{width:14px;height:14px;}
.ch-sess-group-label{font-size:10.5px;color:var(--muted2);text-transform:uppercase;letter-spacing:.04em;margin:12px 0 6px;}
.ch-sess-group-label:first-child{margin-top:0;}
.ch-sess-row{display:flex;align-items:flex-start;gap:9px;padding:7px 0;font-size:12.5px;}
.ch-sess-row .dot{width:8px;height:8px;border-radius:50%;margin-top:5px;flex-shrink:0;}
.ch-sess-title{font-weight:600;color:var(--text);}
.ch-sess-time{font-size:11px;color:var(--muted2);margin-top:1px;}

button, .btn{
  font-family:'Inter';border:1px solid var(--line2);background:var(--panel2);color:var(--text);
  padding:8px 14px;border-radius:3px;font-size:13px;font-weight:500;cursor:pointer;transition:.12s;
}
button:hover,.btn:hover{border-color:var(--mint);color:var(--mint);}
.btn-primary{background:var(--mint);border-color:var(--mint);color:#06251a;font-weight:600;}
.btn-primary:hover{background:#2fd98c;border-color:#2fd98c;color:#06251a;}
.btn-full{display:flex;align-items:center;justify-content:center;width:100%;margin-top:12px;gap:6px;}
.btn-sm{padding:5px 10px;font-size:12px;}
select,input[type=text],input[type=number]{
  font-family:'Inter';background:var(--panel2);border:1px solid var(--line2);color:var(--text);
  padding:8px 11px;border-radius:3px;font-size:13px;
}
input::placeholder{color:var(--muted2);}

.view{display:none;animation:fade .25s ease;}
.view.active{display:block;}
@keyframes fade{from{opacity:0;transform:translateY(4px);}to{opacity:1;transform:translateY(0);}}

/* phase tags */
.tag{display:inline-block;padding:3px 10px;border-radius:100px;font-size:11px;font-weight:600;letter-spacing:.02em;}
.tag-build{background:var(--blue-soft);color:var(--blue);}
.tag-peak{background:var(--amber-soft);color:var(--amber);}
.tag-regenerate{background:var(--violet-soft);color:var(--violet);}
.tag-foundation{background:rgba(150,162,184,.14);color:var(--muted);}
.tag-taper{background:var(--red-soft);color:var(--red);}
.tag-bye{background:var(--mint-soft);color:var(--mint);}

/* timeline / week pills */
.timeline{display:flex;overflow-x:auto;gap:6px;padding:4px 0 10px;}
.tl-seg{flex:0 0 auto;min-width:66px;padding:9px 11px;border-radius:var(--radius-sm);background:var(--panel2);border:1px solid var(--line);cursor:pointer;transition:.12s;}
.tl-seg:hover{border-color:var(--mint);}
.tl-seg.current{background:var(--mint);border-color:var(--mint);}
.tl-seg.current .n,.tl-seg.current .p{color:#06251a;}
.tl-seg .n{font-size:10px;color:var(--muted2);}
.tl-seg .p{font-size:12px;font-weight:600;white-space:nowrap;color:var(--text);}

.weekpills{display:flex;gap:6px;overflow-x:auto;padding:2px 0 4px;}
.weekpill{flex:0 0 auto;width:34px;height:34px;border-radius:3px;background:var(--panel2);border:1px solid var(--line);display:flex;align-items:center;justify-content:center;font-size:12.5px;font-weight:600;color:var(--muted);cursor:pointer;transition:.12s;}
.weekpill:hover{border-color:var(--mint);color:var(--text);}
.weekpill.active{background:var(--mint);border-color:var(--mint);color:#06251a;}

table{width:100%;border-collapse:collapse;font-size:13px;}
th{text-align:left;color:var(--muted2);font-weight:600;font-size:11px;text-transform:uppercase;letter-spacing:.05em;padding:9px 10px;border-bottom:1px solid var(--line);}
td{padding:10px 10px;border-bottom:1px solid var(--line);vertical-align:top;}
tr:last-child td{border-bottom:none;}
tr.hoverable:hover{background:var(--panel2);cursor:pointer;}
.tbl-wrap{overflow-x:auto;}

/* day badge (weekly sessions table) */
.day-badge{display:inline-flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;width:56px;padding:7px 4px;border-radius:3px;font-family:'Inter';font-weight:700;font-size:11px;letter-spacing:.03em;}
.day-badge .sub{font-weight:500;font-size:9.5px;letter-spacing:.01em;text-align:center;line-height:1.15;}
.day-mon{background:var(--mint-soft);color:var(--mint);}
.day-tue{background:var(--blue-soft);color:var(--blue);}
.day-wed{background:var(--amber-soft);color:var(--amber);}
.day-thu{background:var(--violet-soft);color:var(--violet);}
.exname{font-weight:600;color:var(--text);}
.exgroup{font-size:10.5px;color:var(--muted2);text-transform:uppercase;letter-spacing:.03em;margin-bottom:2px;}
.exload{color:var(--muted);font-size:12px;}
.exnotes{color:var(--muted2);font-size:11.5px;margin-top:2px;}
.daysep td{border-bottom:1px solid var(--line2);}

/* phase cards */
.phase-card{background:var(--panel);border:1px solid var(--line);border-top:3px solid var(--line2);border-radius:var(--radius);padding:16px;cursor:pointer;transition:.12s;}
.phase-card:hover{border-color:var(--mint);}
.phase-card.sel{background:var(--panel2);}
.phase-card .num{font-size:11px;color:var(--muted2);}
.phase-card h4{font-size:15px;margin:4px 0 6px;}
.phase-card .rng{font-size:12px;color:var(--muted);}
.pc-blue{border-top-color:var(--blue);} .pc-blue h4{color:var(--blue);}
.pc-amber{border-top-color:var(--amber);} .pc-amber h4{color:var(--amber);}
.pc-red{border-top-color:var(--red);} .pc-red h4{color:var(--red);}
.pc-mint{border-top-color:var(--mint);} .pc-mint h4{color:var(--mint);}
.pc-violet{border-top-color:var(--violet);} .pc-violet h4{color:var(--violet);}
.pc-muted{border-top-color:var(--line2);}

/* week viewer */
.weeknav{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:14px;}
.daytabs{display:flex;gap:6px;margin-bottom:14px;flex-wrap:wrap;}
.daytab{padding:9px 17px;border-radius:3px;background:var(--panel2);border:1px solid var(--line);cursor:pointer;font-weight:600;font-size:13px;color:var(--muted);}
.daytab.active{background:var(--mint);color:#06251a;border-color:var(--mint);}
.exline{display:flex;gap:10px;padding:9px 0;border-bottom:1px solid var(--line);font-size:13.5px;}
.exline:last-child{border-bottom:none;}
.exline .lbl{color:var(--mint);font-weight:600;min-width:180px;flex-shrink:0;}
.exline .val{color:var(--text);}
.checkbtn{width:20px;height:20px;border-radius:2px;border:1.5px solid var(--line2);background:transparent;flex-shrink:0;cursor:pointer;display:flex;align-items:center;justify-content:center;}
.checkbtn.done{background:var(--mint);border-color:var(--mint);}
.checkbtn.done::after{content:"✓";color:#06251a;font-size:12px;font-weight:800;}

/* weekly sessions — card layout */
.wk-cards{display:flex;flex-direction:column;gap:12px;}
.wk-head-row{display:flex;gap:20px;padding:0 20px 2px;}
.wk-head-day{flex:0 0 150px;font-size:11px;font-weight:700;color:var(--muted2);text-transform:uppercase;letter-spacing:.08em;}
.wk-head-cols{flex:1;display:grid;grid-template-columns:1fr 160px 130px;column-gap:20px;}
.wk-head-cols span{font-size:11px;font-weight:700;color:var(--muted2);text-transform:uppercase;letter-spacing:.08em;}
.wk-day-card{display:flex;gap:20px;background:var(--panel);border:1px solid var(--line);border-left:4px solid var(--mint);border-radius:var(--radius-sm);padding:16px 20px;}
.wk-day-card.day-rest{background:var(--panel2);}
.wk-day-cell{flex:0 0 150px;display:flex;flex-direction:column;gap:4px;}
.wk-day-name{font-family:'Inter';font-weight:800;font-size:15px;letter-spacing:.03em;color:var(--text);}
.wk-day-sub{font-size:11.5px;color:var(--muted);}
.wk-day-cell .checkbtn{margin-top:6px;}
.wk-ex-grid{flex:1;display:grid;grid-template-columns:1fr 160px 130px;row-gap:10px;column-gap:20px;align-items:center;}
.wk-ex-name{font-size:13.5px;font-weight:600;color:var(--text);line-height:1.3;}
.wk-ex-sr{font-size:13px;color:var(--muted);}
.wk-ex-wt{font-size:13px;color:var(--muted);}
.wk-wt-input{width:100%;max-width:94px;background:var(--panel2);border:1px solid var(--line2);border-radius:2px;color:var(--text);padding:6px 9px;font-family:'Inter';font-size:13px;transition:border-color .12s;}
.wk-wt-input::placeholder{color:var(--muted2);font-size:11px;}
.wk-wt-input:focus-visible{outline:2px solid var(--mint);outline-offset:1px;border-color:var(--mint);}
.wk-wt-input.wk-saved{border-color:var(--mint);color:var(--mint);}
.wk-note-row{grid-column:1/-1;font-style:italic;color:var(--muted2);font-size:12px;line-height:1.4;}
.wk-wide-val{grid-column:2/-1;color:var(--muted);font-size:12.5px;}
.wk-day-desc{color:var(--muted);font-size:12.5px;line-height:1.4;}
.wk-day-fixture{color:var(--amber);font-size:12.5px;font-weight:600;}
@media(max-width:760px){
  .wk-head-row{display:none;}
  .wk-day-card{flex-direction:column;gap:12px;}
  .wk-day-cell{flex-direction:row;align-items:center;gap:10px;}
  .wk-day-cell .checkbtn{margin-top:0;}
  .wk-ex-grid{grid-template-columns:1fr 100px 84px;column-gap:10px;}
}

/* exercise bank */
.filterchip-row{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:16px;}
.filterchip{padding:7px 15px;border-radius:100px;background:var(--panel2);border:1px solid var(--line);font-size:12.5px;font-weight:600;color:var(--muted);cursor:pointer;}
.filterchip:hover{border-color:var(--mint);}
.filterchip.active{background:var(--mint);border-color:var(--mint);color:#06251a;}
.exbank-cat{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:17px;}
.exbank-cat h4{font-size:15px;margin-bottom:4px;}
.exbank-cat .use{font-size:11px;color:var(--mint);text-transform:uppercase;letter-spacing:.04em;margin-bottom:8px;font-weight:600;}
.exbank-cat .ex{font-size:13px;color:var(--text);margin-bottom:8px;line-height:1.5;}
.exbank-cat .note{font-size:12px;color:var(--muted);border-top:1px dashed var(--line);padding-top:8px;}

/* accordion */
.acc-item{border:1px solid var(--line);border-radius:var(--radius);margin-bottom:10px;overflow:hidden;background:var(--panel);}
.acc-head{padding:15px 17px;cursor:pointer;display:flex;justify-content:space-between;align-items:center;font-weight:600;font-size:14.5px;}
.acc-head:hover{background:var(--panel2);}
.acc-head .chev{transition:transform .15s;color:var(--muted2);}
.acc-item.open .chev{transform:rotate(180deg);}
.acc-body{max-height:0;overflow:hidden;transition:max-height .22s ease;}
.acc-item.open .acc-body{max-height:900px;}
.acc-body-inner{padding:0 17px 17px;}

.searchbar{display:flex;gap:10px;margin-bottom:18px;flex-wrap:wrap;}
.searchbar input{flex:1;min-width:200px;}

.fixture-row{display:grid;grid-template-columns:70px 100px 50px 1fr 90px;gap:10px;align-items:center;padding:12px 10px;border-bottom:1px solid var(--line);font-size:13.5px;}
.fixture-row.head{color:var(--muted2);font-size:11px;text-transform:uppercase;letter-spacing:.04em;border-bottom:1px solid var(--line2);}
.venue-h{color:var(--mint);font-weight:700;}
.venue-a{color:var(--muted);font-weight:700;}
.result-w{color:var(--mint);font-weight:700;}
.result-l{color:var(--red);font-weight:700;}
.result-tbd{color:var(--muted2);}
.result-pend{color:var(--amber);font-size:12px;font-weight:600;}
.sl-row{display:flex;align-items:center;gap:14px;padding:11px 8px;border-bottom:1px solid var(--line);cursor:pointer;border-radius:3px;}
.sl-row:last-child{border-bottom:none;}
.sl-row:hover{background:var(--panel2);}
.sl-row .day-badge{flex-shrink:0;}
.sl-main{flex:1;min-width:0;}
.sl-title{font-size:13.5px;font-weight:600;color:var(--text);}
.sl-sub{font-size:12px;color:var(--muted2);margin-top:2px;}
.sl-lift{font-size:12px;color:var(--muted);text-align:right;flex-shrink:0;max-width:38%;}
.sl-tick{color:var(--mint);flex-shrink:0;width:18px;height:18px;}
@media(max-width:640px){.sl-lift{display:none;}}
.fixture-row.next{background:var(--mint-soft);box-shadow:inset 3px 0 0 var(--mint);}
.fixture-row .ko{color:var(--muted2);font-size:11.5px;margin-left:8px;}
.nx-badge{display:inline-block;margin-left:8px;padding:1px 7px;border-radius:100px;background:var(--mint);color:#06251a;font-size:10px;font-weight:700;letter-spacing:.05em;vertical-align:middle;}
.feed-note{display:flex;flex-wrap:wrap;align-items:center;gap:6px 14px;font-size:12px;color:var(--muted);margin:-8px 0 16px;padding-right:220px;}
@media(max-width:900px){.feed-note{padding-right:0;}}
.feed-note b{color:var(--text);font-weight:600;}
.feed-note a{color:var(--mint);text-decoration:none;font-weight:600;}
.feed-note a:hover{text-decoration:underline;}
.feed-dot{width:7px;height:7px;border-radius:50%;background:var(--mint);display:inline-block;flex-shrink:0;margin-right:-6px;}
.feed-warn{background:var(--amber-soft);color:var(--amber);border-radius:100px;padding:2px 11px;font-weight:600;}
.lt-sum{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:16px;}
.lt-stat{background:var(--panel2);border:1px solid var(--line);border-radius:var(--radius);padding:10px 16px;min-width:112px;}
.lt-stat .l{font-size:10.5px;color:var(--muted2);text-transform:uppercase;letter-spacing:.06em;}
.lt-stat .v{font-size:20px;font-weight:700;color:var(--text);margin-top:2px;font-variant-numeric:tabular-nums;}
.lt-table{min-width:580px;font-size:13.5px;font-variant-numeric:tabular-nums;}
.lt-table th{text-align:center;padding:9px 8px;white-space:nowrap;}
.lt-table td{text-align:center;padding:10px 8px;vertical-align:middle;}
.lt-table th:nth-child(2),.lt-table td:nth-child(2){text-align:left;}
.lt-table td.pos{color:var(--muted2);font-weight:600;width:34px;}
.lt-table td.team{font-weight:600;color:var(--text);white-space:nowrap;}
.lt-table td.pts{font-weight:800;color:var(--text);}
.lt-table td.up{color:var(--mint);}
.lt-table td.down{color:var(--red);}
.lt-table tr.me td{background:var(--mint-soft);}
.lt-table tr.me td.pos,.lt-table tr.me td.team{color:var(--mint);}
.lt-table tr.me td:first-child{box-shadow:inset 3px 0 0 var(--mint);}
.lt-key{margin-top:12px;font-size:11.5px;color:var(--muted2);line-height:1.65;}

.testing-input{width:90px;}
label.tm-lbl{font-size:12.5px;color:var(--muted);}

.notebox{background:var(--amber-soft);border:1px solid rgba(246,185,77,.3);border-radius:var(--radius-sm);padding:13px 15px;font-size:13px;color:var(--amber);margin-bottom:16px;}
.insight-box{display:flex;gap:11px;align-items:flex-start;background:var(--mint-soft);border:1px solid rgba(62,231,155,.3);border-radius:var(--radius-sm);padding:13px 15px;font-size:13px;color:var(--text);}
.insight-box svg{width:18px;height:18px;color:var(--mint);flex-shrink:0;margin-top:1px;}

/* ---- progress tracking ---- */
.ptrack-stat{background:var(--panel);border:1.5px solid var(--line2);border-radius:var(--radius);padding:16px 18px;}
.ptrack-stat.clickable{cursor:pointer;transition:border-color .12s,background .12s;}
.ptrack-stat.clickable:hover{background:var(--panel2);}
.ptrack-stat.clickable:focus-visible{outline:2px solid var(--mint);outline-offset:2px;}
.ptrack-stat .ps-head{display:flex;align-items:center;gap:9px;color:var(--muted);font-size:13px;font-weight:600;margin-bottom:10px;}
.ptrack-stat .ps-head svg{width:16px;height:16px;flex-shrink:0;}
.ptrack-stat .ps-log{margin-left:auto;font-size:11px;font-weight:600;padding:2px 9px;border:1px solid currentColor;border-radius:100px;opacity:.75;}
.ptrack-stat.clickable:hover .ps-log{opacity:1;}
.ptrack-stat .ps-val{font-family:'Inter',sans-serif;font-size:25px;font-weight:700;letter-spacing:-.02em;}
.ptrack-stat .ps-sub{font-size:11.5px;color:var(--muted2);margin-top:5px;line-height:1.45;}
.ps-mint{border-color:rgba(62,231,155,.35);} .ps-mint .ps-head{color:var(--mint);} .ps-mint .ps-val{color:var(--mint);}
.ps-amber{border-color:rgba(246,185,77,.35);} .ps-amber .ps-head{color:var(--amber);} .ps-amber .ps-val{color:var(--amber);}
.ps-blue{border-color:rgba(91,156,246,.35);} .ps-blue .ps-head{color:var(--blue);} .ps-blue .ps-val{color:var(--blue);}
.ps-violet{border-color:rgba(176,131,240,.35);} .ps-violet .ps-head{color:var(--violet);} .ps-violet .ps-val{color:var(--violet);}
.ps-mint.clickable:hover{border-color:var(--mint);} .ps-amber.clickable:hover{border-color:var(--amber);}
.ps-blue.clickable:hover{border-color:var(--blue);} .ps-violet.clickable:hover{border-color:var(--violet);}

.ps-rows{margin-top:11px;padding-top:9px;border-top:1px dashed var(--line2);display:flex;flex-direction:column;gap:5px;}
.ps-row{display:flex;justify-content:space-between;align-items:baseline;gap:10px;font-size:11.5px;color:var(--muted);}
.ps-row .nm{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.ps-row .chg{font-weight:600;white-space:nowrap;}
.chg-up{color:var(--mint);} .chg-down{color:var(--red);} .chg-warn{color:var(--amber);} .chg-flat{color:var(--muted2);}

.pt-charts{display:grid;grid-template-columns:repeat(6,1fr);gap:16px;}
.pt-charts .trend-card{grid-column:span 2;min-width:0;}
.pt-charts .trend-card.wide{grid-column:span 3;}
@media(max-width:1100px){
  .pt-charts{grid-template-columns:repeat(2,1fr);}
  .pt-charts .trend-card,.pt-charts .trend-card.wide{grid-column:span 1;}
  .pt-charts .trend-card:last-child{grid-column:span 2;}
}
@media(max-width:640px){
  .pt-charts{grid-template-columns:1fr;}
  .pt-charts .trend-card:last-child{grid-column:span 1;}
}
.trend-card .tc-title{font-size:14px;font-weight:600;color:var(--text);margin-bottom:8px;}
.trend-card .tc-val{font-family:'Inter',sans-serif;font-size:26px;font-weight:700;letter-spacing:-.02em;display:inline-block;}
.trend-card .tc-delta{font-size:12.5px;font-weight:600;margin-left:10px;display:inline-block;}
.trend-card .tc-note{font-size:11.5px;color:var(--muted2);margin-top:4px;}
.trend-card .tc-chart{margin-top:12px;}
.trend-card .tc-empty{display:flex;flex-direction:column;align-items:flex-start;gap:12px;padding:34px 0 26px;color:var(--muted2);font-size:12.5px;}

/* log modal */
.pt-overlay{position:fixed;inset:0;background:rgba(5,8,14,.62);z-index:100;display:flex;align-items:center;justify-content:center;padding:20px;}
.pt-overlay[hidden]{display:none;}
.pt-modal{background:var(--panel);border:1px solid var(--line2);border-radius:var(--radius);width:100%;max-width:470px;max-height:92vh;overflow-y:auto;padding:22px;box-shadow:0 24px 70px rgba(0,0,0,.5);}
.pt-modal [hidden]{display:none !important;}
.pt-mhead{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:6px;}
.pt-mhead h3{font-size:18px;letter-spacing:-.01em;}
.pt-x{width:30px;height:30px;padding:0;font-size:18px;line-height:1;flex-shrink:0;}
.pt-help{margin:0 0 16px;font-size:12.5px;color:var(--muted);line-height:1.5;}
.pt-field{display:flex;flex-direction:column;gap:5px;margin-bottom:12px;}
.pt-field label{font-size:12px;font-weight:500;color:var(--muted);}
.pt-modal input,.pt-modal select{width:100%;font-family:'Inter',sans-serif;background:var(--panel2);border:1px solid var(--line2);color:var(--text);padding:9px 11px;border-radius:3px;font-size:14px;}
.pt-modal input:focus-visible,.pt-modal select:focus-visible{outline:2px solid var(--mint);outline-offset:1px;border-color:var(--mint);}
.pt-modal button,.trend-card .btn{font-family:'Inter',sans-serif;}
.pt-modal input[type=date]{color-scheme:dark;}
@media (prefers-color-scheme: light){:root:not([data-theme="dark"]) .pt-modal input[type=date]{color-scheme:light;}}
.pt-row3{display:grid;grid-template-columns:1.3fr 1fr 1fr;gap:10px;}
.pt-row2{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
.pt-preview{min-height:18px;margin:2px 0 8px;font-size:12.5px;font-weight:600;color:var(--mint);}
.pt-msg{min-height:18px;margin-bottom:10px;font-size:12.5px;}
.pt-msg.err{color:var(--red);} .pt-msg.ok{color:var(--mint);}
.pt-actions{display:flex;gap:8px;justify-content:flex-end;}
.pt-entries{margin-top:20px;padding-top:14px;border-top:1px solid var(--line);}
.pt-entries h4{font-size:12px;font-weight:600;color:var(--muted2);margin-bottom:6px;}
.pt-entry{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:9px 0;border-bottom:1px solid var(--line);font-size:13px;}
.pt-entry:last-child{border-bottom:none;}
.pt-entry .meta{font-size:11.5px;color:var(--muted2);margin-top:2px;}
.pt-entry .none{color:var(--muted2);font-size:12.5px;}
.pt-del{padding:3px 10px;font-size:11.5px;color:var(--muted);flex-shrink:0;}
.pt-del.armed{border-color:var(--red);color:var(--red);}
@media(max-width:640px){.pt-modal input,.pt-modal select{font-size:16px;}}

@media(max-width:900px){
  .sidebar{position:fixed;left:-240px;z-index:50;transition:left .2s;box-shadow:0 0 40px rgba(0,0,0,.5);}
  .sidebar.open{left:0;}
  main{padding:18px 16px 60px;}
  #menuBtn{display:flex !important;}
}
#menuBtn{display:none;align-items:center;justify-content:center;width:36px;height:36px;border-radius:2px;margin-right:10px;}
</style>
</head>
<body>

<div id="authGate" class="auth-gate">
  <div class="auth-card">
    <div class="auth-brand">Athlete Project</div>
    <div class="auth-sub" id="authSub">Sign in to your dashboard</div>

    <div id="authError" class="auth-error" style="display:none;"></div>

    <form id="authForm">
      <label class="auth-label">Username</label>
      <input class="auth-input" id="authUsername" type="text" autocomplete="username" required minlength="3" pattern="[A-Za-z0-9_\.\-]+" title="Letters, numbers, underscores, dots and hyphens only">

      <label class="auth-label">Password</label>
      <input class="auth-input" id="authPassword" type="password" autocomplete="current-password" required minlength="6">

      <button type="submit" class="auth-btn" id="authSubmitBtn">Sign in</button>
    </form>

    <button type="button" class="auth-link" id="authToggleMode">Don't have an account? Sign up</button>
  </div>
</div>

<div id="setupGate" class="auth-gate" style="display:none;">
  <div class="auth-card" style="max-width:420px;">
    <div class="auth-brand">Set up your programme</div>
    <div class="auth-sub">Tell us your sport and position and we'll load your full plan</div>

    <div id="setupError" class="auth-error" style="display:none;"></div>

    <form id="setupForm">
      <label class="auth-label">Sport</label>
      <select class="auth-input" id="setupSport" required>
        <option value="">Select a sport…</option>
        <option value="rugby">Rugby</option>
        <option value="football">Football</option>
        <option value="netball">Netball</option>
      </select>

      <label class="auth-label">Position</label>
      <select class="auth-input" id="setupPosition" required disabled>
        <option value="">Select a sport first…</option>
      </select>

      <div id="setupGoalWrap">
        <label class="auth-label">Development focus</label>
        <select class="auth-input" id="setupGoal">
          <option value="SP-P">Speed &amp; power</option>
          <option value="HST">Hypertrophy &amp; strength</option>
        </select>
      </div>

      <label class="auth-label">Do you play for a club?</label>
      <select class="auth-input" id="setupHasClub">
        <option value="no">No</option>
        <option value="yes">Yes</option>
      </select>

      <div id="setupClubWrap" style="display:none;">
        <label class="auth-label">Club / team name</label>
        <input class="auth-input" id="setupClubName" type="text" placeholder="e.g. Billingham RFC">
      </div>

      <button type="submit" class="auth-btn" id="setupSubmitBtn" disabled>Load my programme</button>
    </form>
  </div>
</div>

<div id="settingsModal" class="auth-gate" style="display:none;background:rgba(0,0,0,.5);">
  <div class="auth-card" style="max-width:420px;position:relative;">
    <button type="button" id="settingsClose" style="position:absolute;top:14px;right:14px;background:none;border:none;color:var(--muted);font-size:18px;cursor:pointer;line-height:1;">&times;</button>
    <div class="auth-brand">Settings</div>
    <div class="auth-sub" id="settingsUsername">&nbsp;</div>

    <div id="settingsError" class="auth-error" style="display:none;"></div>

    <form id="settingsForm">
      <label class="auth-label">Sport</label>
      <select class="auth-input" id="setSport" required>
        <option value="rugby">Rugby</option>
        <option value="football">Football</option>
        <option value="netball">Netball</option>
      </select>

      <label class="auth-label">Position</label>
      <select class="auth-input" id="setPosition" required></select>

      <div id="setGoalWrap">
        <label class="auth-label">Development focus</label>
        <select class="auth-input" id="setGoal">
          <option value="SP-P">Speed &amp; power</option>
          <option value="HST">Hypertrophy &amp; strength</option>
        </select>
      </div>

      <label class="auth-label">Do you play for a club?</label>
      <select class="auth-input" id="setHasClub">
        <option value="no">No</option>
        <option value="yes">Yes</option>
      </select>

      <div id="setClubWrap" style="display:none;">
        <label class="auth-label">Club / team name</label>
        <input class="auth-input" id="setClubName" type="text">
      </div>

      <button type="submit" class="auth-btn" id="settingsSaveBtn">Save changes</button>
    </form>

    <button type="button" class="auth-link" id="settingsSignOutBtn" style="color:var(--red);">Sign out</button>
  </div>
</div>

<div id="app" style="display:none;">
  <nav class="sidebar" id="sidebar">
    <div class="brand" style="border-bottom:none;margin-bottom:0;padding-bottom:12px;">
      <img src="data:image/png;base64," alt="Athlete Project" style="height:34px;width:auto;display:block;" />
    </div>

    <div class="nav-group">
      <div class="navitem active" data-view="overview">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12l2-2 4 4 8-8 4 4"/><path d="M3 20h18"/></svg>
        Overview
      </div>
      <div class="navitem" data-view="fixtures">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M8 2v4M16 2v4M3 9h18"/></svg>
        Fixtures
      </div>
      <div class="navitem" data-view="periodisation">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19h16M6 15l4-6 3 4 5-9"/></svg>
        Periodisation Plan
      </div>
      <div class="navitem" data-view="weekly">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 10h18M8 2v4M16 2v4"/></svg>
        Weekly Sessions
      </div>
      <div class="navitem" data-view="progress">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19V10M11 19V5M18 19v-7"/></svg>
