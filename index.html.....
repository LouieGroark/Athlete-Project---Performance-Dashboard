function renderExBank(query){
  query = (query||'').toLowerCase();
  const wrap = document.getElementById('exbank-list');
  wrap.innerHTML = '';
  DATA.exbank.forEach(e=>{
    if(exUseFilter && e.use!==exUseFilter) return;
    const hay = (e.cat+' '+e.use+' '+e.examples+' '+e.notes).toLowerCase();
    if(query && !hay.includes(query)) return;
