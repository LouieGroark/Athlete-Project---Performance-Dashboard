function parseExerciseLine(line){
  const idx = line.indexOf(':');
  if(idx<0 || idx>=40) return {isNote:true, text:line};
  const group = line.slice(0,idx).trim();
  const rest = line.slice(idx+1).trim();
  const parts = rest.split(/\s+—\s+/);
  let name, presc;
  if(parts.length>=3){ name = parts[0].trim()+' ('+parts[1].trim()+')'; presc = parts.slice(2).join(' — ').trim(); }
  else if(parts.length===2){ name = parts[0].trim(); presc = parts[1].trim(); }
  else { name = group; presc = rest; }
  const am = presc.split(/\s+@\s+/);
  const hasLoad = am.length>1;
  const setsReps = am[0] ? am[0].trim() : '—';
  const load = hasLoad ? am[1].trim() : '';
  const looksLikePrescription = hasLoad || /\d/.test(setsReps);
  if(!looksLikePrescription){
    return {isNote:false, group, name, wide:true, wideText:setsReps};
  }
  return {isNote:false, group, name, setsReps, load};
}
