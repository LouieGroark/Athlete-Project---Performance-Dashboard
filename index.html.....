});
function chSaveWellbeing(){ saveLocal('brfc_wellbeing', chWellbeing); }
const chClamp = (v, lo, hi) => Math.max(lo, Math.min(hi, v));
function chReadiness(w){
  const subs = [
    chClamp(w.sleepHrs / 8 * 10, 0, 10),
    chClamp(w.sleepEfficiency / 100 * 10, 0, 10),
    chClamp(w.recoveryScore / 100 * 10, 0, 10),
    10 - chClamp(w.strain / 21 * 10, 0, 10),
    chClamp((80 - w.restingHR) / 40 * 10, 0, 10),
    chClamp(w.hrv / 70 * 10, 0, 10)
  ];
  return Math.round(chClamp(subs.reduce((a, b) => a + b, 0) / subs.length, 0, 10) * 10);
}
function chWeekSessionDays(wk){ return ['mon', 'tue', 'wed', 'thu'].filter(k => wk[k]); }
function chWeekCompletion(wk){
  const days = chWeekSessionDays(wk);
  const done = days.filter(k => completed[`${wk.wk}-${k}`]).length;
  return {done, total: days.length, pct: days.length ? done / days.length * 100 : 0, days};
}
function chFindNextFixture(){ return findNextFixture(); }
function chSparkline(pts, lowerBetter){
  const valid = pts.filter(p => p.value != null);
  if(!valid.length) return {svg: '', last: null, first: null};
  const vals = valid.map(p => p.value);
  let lo = Math.min(...vals), hi = Math.max(...vals);
  if(hi === lo){ hi += 1; lo -= 1; }
  const x = i => 2 + (valid.length === 1 ? 48 : i / (valid.length - 1) * 96);
  const y = v => 30 - ((v - lo) / (hi - lo)) * 24;
  const pts2 = valid.map((p, i) => `${x(i).toFixed(1)},${y(p.value).toFixed(1)}`).join(' ');
  const last = valid[valid.length - 1], first = valid[0];
  const improving = lowerBetter ? last.value < first.value : last.value > first.value;
  const color = valid.length > 1 ? (last.value === first.value ? 'var(--muted2)' : (improving ? 'var(--mint)' : 'var(--red)')) : 'var(--mint)';
  return {
    svg: `<svg viewBox="0 0 100 34" width="100%" height="34"><polyline points="${pts2}" fill="none" stroke="${color}" stroke-width="2"/></svg>`,
    last, first, color
  };
}
function chTrendCard(title, unit, dp, pts, lowerBetter, emptyLabel, goView){
  const {svg, last, first, color} = chSparkline(pts, lowerBetter);
  if(!last){
    return `<div class="ch-trend-card"><div class="l">${title}</div><div style="font-size:11.5px;color:var(--muted2);margin:8px 0;">${emptyLabel}</div>
      <button type="button" class="btn btn-sm" data-goview="${goView}">Go log one</button></div>`;
  }
  let deltaHtml = '';
  if(first && last !== first){
    const d = last.value - first.value;
    if(Math.abs(d) > 0.0001) deltaHtml = `<div class="d" style="color:${color};">${d > 0 ? '↑' : '↓'} ${Math.abs(d).toFixed(dp)}${unit}</div>`;
  }
  const firstLabel = pts.find(p => p.value != null).label, lastLabelPt = [...pts].reverse().find(p => p.value != null);
  return `<div class="ch-trend-card">
    <div class="l">${title}</div><div class="v">${last.value.toFixed(dp)}${unit}</div>${deltaHtml || '<div class="d">&nbsp;</div>'}
    ${svg}
    <div class="ch-trend-wks"><span>${firstLabel}</span><span>${lastLabelPt.label}</span></div>
  </div>`;
}
function chLoadChartSvg(data){
  const W = 340, H = 170, padL = 26, padR = 4, padT = 6, padB = 32, plotW = W - padL - padR, plotH = H - padT - padB;
  const maxV = Math.max(4, ...data.map(d => d.done));
  const slot = plotW / data.length;
  const y = v => padT + plotH - (v / maxV) * plotH;
  const bars = data.map((d, i) => {
    const bw = Math.min(20, slot * 0.5), cx = padL + slot * (i + 0.5);
    return `<rect x="${(cx - bw / 2).toFixed(1)}" y="${y(d.done).toFixed(1)}" width="${bw.toFixed(1)}" height="${Math.max(1, y(0) - y(d.done)).toFixed(1)}" rx="2" fill="var(--blue)" opacity="0.9"><title>Wk ${d.wk} · ${d.done} sessions</title></rect>`;
  }).join('');
  const line = data.map((d, i) => `${(padL + slot * (i + 0.5)).toFixed(1)},${y(d.avg).toFixed(1)}`).join(' ');
  const ticks = [0, Math.round(maxV / 2), maxV];
  const grid = ticks.map(t => `<line x1="${padL}" y1="${y(t).toFixed(1)}" x2="${W - padR}" y2="${y(t).toFixed(1)}" stroke="var(--line)" stroke-width="1"/><text x="${padL - 6}" y="${(y(t) + 3).toFixed(1)}" text-anchor="end" font-size="9" fill="var(--muted2)">${t}</text>`).join('');
  const xl = data.map((d, i) => `<text x="${(padL + slot * (i + 0.5)).toFixed(1)}" y="${H - 10}" text-anchor="middle" font-size="9" fill="var(--muted2)">Wk ${d.wk}</text>`).join('');
  return `<svg viewBox="0 0 ${W} ${H}" width="100%" style="display:block;">${grid}${bars}<polyline points="${line}" fill="none" stroke="var(--amber)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>${xl}</svg>`;
}
function chTestingSeries(metric){
  return COLUMNS.map(col => {
    const raw = testingVals[metric + '||' + col] || '';
    const m = raw.match(/-?\d+(\.\d+)?/);
    return {label: col.replace('Pre-Season Baseline', 'Baseline').replace(/\s*\(Wk.*\)/, ''), value: m ? parseFloat(m[0]) : null};
  });
}
